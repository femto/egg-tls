// The hashes, HMAC and HKDF against FIPS 180-4 (RFC 6234), RFC 4231 and
// RFC 5869. Run by clutch test: each check prints its name when it fails,
// and main fails if any did.
uses io, alloc

const sha256 = @import("tls/sha256")
const sha512 = @import("tls/sha512")
const hmac = @import("tls/hmac")
const hkdf = @import("tls/hkdf")
const support = @import("support/check.egg")

fn main(io: Io, a: Allocator) !void {
    var t = support.tally()
    sha(io, a, &t, "", "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b", "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e", "empty")
    sha(io, a, &t, "abc", "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7", "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f", "abc")
    sha(io, a, &t, "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1", "3391fdddfc8dc7393707a65b1b4709397cf8b1d162af05abfe8f450de5f36bc6b0455a8520bc4e6f5fe95b1fe3c8452b", "204a8fc6dda82f0a0ced7beb8e08a41657c16ef468b228a8279be331a703c33596fd15c13b1b07f9aa1d3bea57789ca031ad85c7a71dd70354ec631238ca3445", "448 bits")
    sha(io, a, &t, "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu", "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1", "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039", "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909", "896 bits")
    million(io, a, &t)
    pieces(io, a, &t)
    try mac(io, a, &t, "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b", "4869205468657265", "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7", "afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6", "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854", "RFC 4231 case 1")
    try mac(io, a, &t, "4a656665", "7768617420646f2079612077616e7420666f72206e6f7468696e673f", "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843", "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649", "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737", "RFC 4231 case 2")
    try mac(io, a, &t, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd", "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe", "88062608d3e6ad8a0aa2ace014c8a86f0aa635d947ac9febe83ef4e55966144b2a5ab39dc13814b94e3ab6e101a34f27", "fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb", "RFC 4231 case 3")
    try mac(io, a, &t, "0102030405060708090a0b0c0d0e0f10111213141516171819", "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd", "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b", "3e8a69b7783c25851933ab6290af6ca77a9981480850009cc5577c6e1f573b4e6801dd23c4a7d679ccf8a386c674cffb", "b0ba465637458c6990e5a8c5f61d4af7e576d97ff94b872de76f8050361ee3dba91ca5c11aa25eb4d679275cc5788063a5f19741120c4f2de2adebeb10a298dd", "RFC 4231 case 4")
    try mac(io, a, &t, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "54657374205573696e67204c6172676572205468616e20426c6f636b2d53697a65204b6579202d2048617368204b6579204669727374", "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54", "4ece084485813e9088d2c63a041bc5b44f9ef1012a2b588f3cd11f05033ac4c60c2ef6ab4030fe8296248df163f44952", "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598", "RFC 4231 case 6")
    try mac(io, a, &t, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "", "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2", "6617178e941f020d351e2f254e8fd32c602420feb0b8fb9adccebb82461e99c5a678cc31e799176d3860e6110c46523e", "e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58", "RFC 4231 case 7")
    try kdf(io, a, &t, "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b", "000102030405060708090a0b0c", "f0f1f2f3f4f5f6f7f8f9", "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5", "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865", "RFC 5869 case 1")
    try kdf(io, a, &t, "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f", "606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9fa0a1a2a3a4a5a6a7a8a9aaabacadaeaf", "b0b1b2b3b4b5b6b7b8b9babbbcbdbebfc0c1c2c3c4c5c6c7c8c9cacbcccdcecfd0d1d2d3d4d5d6d7d8d9dadbdcdddedfe0e1e2e3e4e5e6e7e8e9eaebecedeeeff0f1f2f3f4f5f6f7f8f9fafbfcfdfeff", "06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244", "b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71cc30c58179ec3e87c14c01d5c1f3434f1d87", "RFC 5869 case 2")
    try kdf(io, a, &t, "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b", "", "", "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04", "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8", "RFC 5869 case 3")
    try too_long(io, &t)
    try t.done(io)
}

// The three digests of msg.
fn sha(io: Io, a: Allocator, inout t: support.Tally, msg: str, want256: str, want384: str, want512: str, name: str) void {
    const d256 = sha256.sum(msg)
    t.check_of(io, support.same(a, d256[0..], want256), "SHA-256", name)
    const d384 = sha512.sum384(msg)
    t.check_of(io, support.same(a, d384[0..], want384), "SHA-384", name)
    const d512 = sha512.sum512(msg)
    t.check_of(io, support.same(a, d512[0..], want512), "SHA-512", name)
}

// A million a, given in pieces of 1000.
fn million(io: Io, a: Allocator, inout t: support.Tally) void {
    const chunk = a.alloc(1000, @as(u8, 0x61))
    defer a.free(chunk)
    var h = sha256.Sha256.init()
    var i = 0
    while (i < 1000) {
        h.update(chunk[0..])
        i = i + 1
    }
    const d = h.final()
    t.check(io, support.same(a, d[0..], "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0"), "a million a")
}

// Any split of the message gives the same digest, and a copy keeps the
// hash so far while the original goes on.
fn pieces(io: Io, a: Allocator, inout t: support.Tally) void {
    const msg = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
    const whole256 = sha256.sum(msg)
    const whole512 = sha512.sum512(msg)
    var split = 0
    var ok = true
    while (split <= @len(msg)) {
        var h = sha256.Sha256.init()
        h.update(msg[0..split])
        h.update(msg[split..])
        var g = sha512.Sha512.init()
        g.update(msg[0..split])
        g.update(msg[split..])
        const d = h.final()
        const e = g.final()
        ok = ok and d[0..] == whole256[0..] and e[0..] == whole512[0..]
        split = split + 1
    }
    t.check(io, ok, "every split of the message")
    var h = sha256.Sha256.init()
    h.update("ab")
    const prefix = h
    h.update("c")
    const p = prefix.final()
    const d = h.final()
    t.check(io, support.same(a, p[0..], "fb8e20fc2e4c3f248c60c39bd652f3c1347298bb977b8b4d5903b85055620603") and support.same(a, d[0..], "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"), "a copy keeps the hash so far")
}

fn mac(io: Io, a: Allocator, inout t: support.Tally, key_hex: str, data_hex: str, want256: str, want384: str, want512: str, name: str) !void {
    const key = try support.unhex(a, key_hex)
    defer a.free(key)
    const data = try support.unhex(a, data_hex)
    defer a.free(data)
    var m256 = hmac.Hmac(sha256.Sha256).init(key[0..])
    m256.update(data[0..])
    var t256: [32]u8 = @splat(0)
    m256.final(&t256[0..])
    t.check_of(io, support.same(a, t256[0..], want256), "HMAC-SHA-256", name)
    var m384 = hmac.Hmac(sha512.Sha384).init(key[0..])
    m384.update(data[0..])
    var t384: [48]u8 = @splat(0)
    m384.final(&t384[0..])
    t.check_of(io, support.same(a, t384[0..], want384), "HMAC-SHA-384", name)
    var m512 = hmac.Hmac(sha512.Sha512).init(key[0..])
    m512.update(data[0..])
    var t512: [64]u8 = @splat(0)
    m512.final(&t512[0..])
    t.check_of(io, support.same(a, t512[0..], want512), "HMAC-SHA-512", name)
}

fn kdf(io: Io, a: Allocator, inout t: support.Tally, ikm_hex: str, salt_hex: str, info_hex: str, want_prk: str, want_okm: str, name: str) !void {
    const ikm = try support.unhex(a, ikm_hex)
    defer a.free(ikm)
    const salt = try support.unhex(a, salt_hex)
    defer a.free(salt)
    const info = try support.unhex(a, info_hex)
    defer a.free(info)
    var prk: [32]u8 = @splat(0)
    hkdf.Hkdf(sha256.Sha256).extract(salt[0..], ikm[0..], &prk[0..])
    t.check(io, support.same(a, prk[0..], want_prk), name)
    var okm = a.alloc(@len(want_okm) / 2, @as(u8, 0))
    defer a.free(okm)
    try hkdf.Hkdf(sha256.Sha256).expand(prk[0..], info[0..], &okm[0..])
    t.check(io, support.same(a, okm[0..], want_okm), name)
}

// More than 255 digests is an error.
fn too_long(io: Io, inout t: support.Tally) !void {
    const prk: [32]u8 = @splat(7)
    var out: [8161]u8 = @splat(0)
    var failed = false
    hkdf.Hkdf(sha256.Sha256).expand(prk[0..], "", &out[0..]) catch {
        failed = true
    }
    t.check(io, failed, "expand refuses more than 255 digests")
    var most: [8160]u8 = @splat(0)
    try hkdf.Hkdf(sha256.Sha256).expand(prk[0..], "", &most[0..])
    t.check(io, true, "expand gives 255 digests")
}
