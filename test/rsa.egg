        Sig{ .key = "k2048", .kind = "pkcs1", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 0, .ok = false, .name = "a PSS signature as PKCS#1" },
        Sig{ .key = "k2048", .kind = "pss", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 32, .ok = false, .name = "a PKCS#1 signature as PSS" },
        Sig{ .key = "k2048", .kind = "pkcs1", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 0, .ok = false, .name = "PKCS#1: a zero byte in front" },
        Sig{ .key = "k2048", .kind = "pkcs1", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 0, .ok = false, .name = "PKCS#1: a byte short" },
        Sig{ .key = "k2048", .kind = "pkcs1", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 0, .ok = false, .name = "PKCS#1: the signature is n" },
        Sig{ .key = "k3072", .kind = "pkcs1", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 0, .ok = false, .name = "another key" },
        Sig{ .key = "k2048", .kind = "pkcs1", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 0, .ok = true, .name = "PKCS#1 built by hand" },
