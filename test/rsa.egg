        Sig{ .key = "k2048", .kind = "pkcs1", .hash = "sha256", .digest = "feda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 0, .ok = false, .name = "PKCS#1: the digest changed" },
        Sig{ .key = "k2048", .kind = "pss", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 32, .ok = false, .name = "PSS: a signature byte changed" },
        Sig{ .key = "k2048", .kind = "pss", .hash = "sha256", .digest = "feda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 32, .ok = false, .name = "PSS: the digest changed" },
