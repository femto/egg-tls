        Sig{ .key = "k3072", .kind = "pkcs1", .hash = "sha512", .digest = "348959985fb9373969352ccfff2a38c6c540225307edfe6b217710f94a7ea6831059ee5c3a8fa1123495e38e075a7a55c6b37a86aa657d1c80ccb3aaf285dfaa", .sig = "", .salt = 0, .ok = true, .name = "k3072 PKCS#1 v1.5 sha512" },
        Sig{ .key = "k3072", .kind = "pss", .hash = "sha512", .digest = "348959985fb9373969352ccfff2a38c6c540225307edfe6b217710f94a7ea6831059ee5c3a8fa1123495e38e075a7a55c6b37a86aa657d1c80ccb3aaf285dfaa", .sig = "", .salt = 64, .ok = true, .name = "k3072 PSS sha512" },
        Sig{ .key = "k4096", .kind = "pkcs1", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 0, .ok = true, .name = "k4096 PKCS#1 v1.5 sha256" },
        Sig{ .key = "k4096", .kind = "pss", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 32, .ok = true, .name = "k4096 PSS sha256" },
        Sig{ .key = "k4096", .kind = "pkcs1", .hash = "sha384", .digest = "71747e331ea6291ceb0b35c1d835045338aa34631f0d2522b0081dd8a327c9920a3687d8f41ae54f9d85835085ad3106", .sig = "", .salt = 0, .ok = true, .name = "k4096 PKCS#1 v1.5 sha384" },
        Sig{ .key = "k4096", .kind = "pss", .hash = "sha384", .digest = "71747e331ea6291ceb0b35c1d835045338aa34631f0d2522b0081dd8a327c9920a3687d8f41ae54f9d85835085ad3106", .sig = "", .salt = 48, .ok = true, .name = "k4096 PSS sha384" },
        Sig{ .key = "k4096", .kind = "pkcs1", .hash = "sha512", .digest = "348959985fb9373969352ccfff2a38c6c540225307edfe6b217710f94a7ea6831059ee5c3a8fa1123495e38e075a7a55c6b37a86aa657d1c80ccb3aaf285dfaa", .sig = "", .salt = 0, .ok = true, .name = "k4096 PKCS#1 v1.5 sha512" },
        Sig{ .key = "k4096", .kind = "pss", .hash = "sha512", .digest = "348959985fb9373969352ccfff2a38c6c540225307edfe6b217710f94a7ea6831059ee5c3a8fa1123495e38e075a7a55c6b37a86aa657d1c80ccb3aaf285dfaa", .sig = "", .salt = 64, .ok = true, .name = "k4096 PSS sha512" },
        Sig{ .key = "k2048e3", .kind = "pkcs1", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 0, .ok = true, .name = "k2048e3 PKCS#1 v1.5 sha256" },
        Sig{ .key = "k2048e3", .kind = "pss", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 32, .ok = true, .name = "k2048e3 PSS sha256" },
        Sig{ .key = "k2048e3", .kind = "pkcs1", .hash = "sha384", .digest = "71747e331ea6291ceb0b35c1d835045338aa34631f0d2522b0081dd8a327c9920a3687d8f41ae54f9d85835085ad3106", .sig = "", .salt = 0, .ok = true, .name = "k2048e3 PKCS#1 v1.5 sha384" },
        Sig{ .key = "k2048e3", .kind = "pss", .hash = "sha384", .digest = "71747e331ea6291ceb0b35c1d835045338aa34631f0d2522b0081dd8a327c9920a3687d8f41ae54f9d85835085ad3106", .sig = "", .salt = 48, .ok = true, .name = "k2048e3 PSS sha384" },
        Sig{ .key = "k2048e3", .kind = "pkcs1", .hash = "sha512", .digest = "348959985fb9373969352ccfff2a38c6c540225307edfe6b217710f94a7ea6831059ee5c3a8fa1123495e38e075a7a55c6b37a86aa657d1c80ccb3aaf285dfaa", .sig = "", .salt = 0, .ok = true, .name = "k2048e3 PKCS#1 v1.5 sha512" },
        Sig{ .key = "k2048e3", .kind = "pss", .hash = "sha512", .digest = "348959985fb9373969352ccfff2a38c6c540225307edfe6b217710f94a7ea6831059ee5c3a8fa1123495e38e075a7a55c6b37a86aa657d1c80ccb3aaf285dfaa", .sig = "", .salt = 64, .ok = true, .name = "k2048e3 PSS sha512" },
        Sig{ .key = "k8192", .kind = "pkcs1", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 0, .ok = true, .name = "k8192 PKCS#1 v1.5 sha256" },
        Sig{ .key = "k8192", .kind = "pss", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 32, .ok = true, .name = "k8192 PSS sha256" },
        Sig{ .key = "k8192", .kind = "pkcs1", .hash = "sha384", .digest = "71747e331ea6291ceb0b35c1d835045338aa34631f0d2522b0081dd8a327c9920a3687d8f41ae54f9d85835085ad3106", .sig = "", .salt = 0, .ok = true, .name = "k8192 PKCS#1 v1.5 sha384" },
        Sig{ .key = "k8192", .kind = "pss", .hash = "sha384", .digest = "71747e331ea6291ceb0b35c1d835045338aa34631f0d2522b0081dd8a327c9920a3687d8f41ae54f9d85835085ad3106", .sig = "", .salt = 48, .ok = true, .name = "k8192 PSS sha384" },
        Sig{ .key = "k8192", .kind = "pkcs1", .hash = "sha512", .digest = "348959985fb9373969352ccfff2a38c6c540225307edfe6b217710f94a7ea6831059ee5c3a8fa1123495e38e075a7a55c6b37a86aa657d1c80ccb3aaf285dfaa", .sig = "", .salt = 0, .ok = true, .name = "k8192 PKCS#1 v1.5 sha512" },
        Sig{ .key = "k8192", .kind = "pss", .hash = "sha512", .digest = "348959985fb9373969352ccfff2a38c6c540225307edfe6b217710f94a7ea6831059ee5c3a8fa1123495e38e075a7a55c6b37a86aa657d1c80ccb3aaf285dfaa", .sig = "", .salt = 64, .ok = true, .name = "k8192 PSS sha512" },
        Sig{ .key = "k2048", .kind = "pss", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 0, .ok = true, .name = "PSS with no salt" },
        Sig{ .key = "k2048", .kind = "pss", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 20, .ok = true, .name = "PSS with a 20-byte salt" },
