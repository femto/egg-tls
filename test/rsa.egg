// RSA verification against OpenSSL: 2048-, 2049-, 3072-, 4096- and
// 8192-bit keys (and e = 3), PKCS #1 v1.5 and PSS with SHA-256, -384 and
// -512; then what must be refused: changed signatures and digests, the
// wrong scheme or salt length, a signature of the wrong length or not
// below n, and encodings built by hand and signed with the raw private
// operation (DigestInfo without NULL, short padding with garbage after
// the digest, block type 2, PSS with a wrong trailer or top bit). OpenSSL
// agreed with every expected answer when the vectors were made
// (test/vectors/rsa.rb). Then keys that must be refused, and a salt length
// too long to fit.
uses io, alloc

const rsa = @import("tls/rsa")
const support = @import("support/check.egg")

const Key = struct {
    name: str
    n: str
    e: str
}

const Sig = struct {
    key: str
    kind: str
    hash: str
    digest: str
    sig: str
    salt: i64
    ok: bool
    name: str
}

fn main(io: Io, a: Allocator) !void {
    var t = support.tally()
    const ks = keys()
    const ss = sigs()
    for (ss) |s| {
        for (ks) |k| {
            if (k.name == s.key) {
                try check_sig(io, a, &t, k, s)
            }
        }
    }
    try check_keys(io, a, &t, ks)
    try huge_salt(io, a, &t, ks[0], ss[0])
    try t.done(io)
}

fn hash_of(name: str) rsa.Hash {
    if (name == "sha256") {
        return .sha256
    }
    return if (name == "sha384") .sha384 else .sha512
}

fn check_sig(io: Io, a: Allocator, inout t: support.Tally, k: Key, s: Sig) !void {
    const n = try support.unhex(a, k.n)
    defer a.free(n)
    const e = try support.unhex(a, k.e)
    defer a.free(e)
    const key = try rsa.public_key(n[0..], e[0..])
    const digest = try support.unhex(a, s.digest)
    defer a.free(digest)
    const sig = try support.unhex(a, s.sig)
    defer a.free(sig)
    var ok = true
    if (s.kind == "pss") {
        rsa.verify_pss(key, hash_of(s.hash), digest[0..], sig[0..], s.salt) catch {
            ok = false
        }
    } else {
        rsa.verify_pkcs1(key, hash_of(s.hash), digest[0..], sig[0..]) catch {
            ok = false
        }
    }
    t.check(io, ok == s.ok, s.name)
}

fn check_keys(io: Io, a: Allocator, inout t: support.Tally, ks: [7]Key) !void {
    for (ks) |k| {
        if (k.name == "k1024") {
            const n = try support.unhex(a, k.n)
            defer a.free(n)
            t.check(io, key_error(n[0..], "\x01\x00\x01") == error.KeyTooSmall, "a 1024-bit key")
        }
        if (k.name == "k2048") {
            const n = try support.unhex(a, k.n)
            defer a.free(n)
            t.check(io, key_error(n[0..], "\x01\x00\x01") == error.None, "a 2048-bit key")
            t.check(io, key_error(n[0..], "\x00\x00\x01\x00\x01") == error.None, "an exponent with leading zeros")
            // DER's INTEGER puts a zero in front of a modulus whose top bit is set.
            const padded = a.concat("\x00\x00", n)
            defer a.free(padded)
            const key = try rsa.public_key(padded[0..], "\x01\x00\x01")
            t.check(io, key.size == 256 and key.bits == 2048, "a modulus with leading zeros")
            t.check(io, key_error(n[0..], "\x01\x00\x00") == error.BadKey, "an even exponent")
            t.check(io, key_error(n[0..], "\x01") == error.BadKey, "exponent 1")
            t.check(io, key_error(n[0..], "\x80\x00\x00\x01") == error.BadKey, "exponent 2^31 + 1")
            t.check(io, key_error(n[0..], "\x01\x00\x00\x00\x01") == error.BadKey, "a five-byte exponent")
            var even = a.concat(n, "")
            defer a.free(even)
            even[@len(even) - 1] = even[@len(even) - 1] & 0xFE
            t.check(io, key_error(even[0..], "\x01\x00\x01") == error.BadKey, "an even modulus")
        }
    }
    const big: [1025]u8 = @splat(0xFF)
    t.check(io, key_error(big[0..], "\x01\x00\x01") == error.KeyTooLarge, "an 8200-bit key")
}

// A salt length near the largest i64: refused, not an overflow.
fn huge_salt(io: Io, a: Allocator, inout t: support.Tally, k: Key, s: Sig) !void {
    const n = try support.unhex(a, k.n)
    defer a.free(n)
    const e = try support.unhex(a, k.e)
    defer a.free(e)
    const key = try rsa.public_key(n[0..], e[0..])
    const digest = try support.unhex(a, s.digest)
    defer a.free(digest)
    const sig = try support.unhex(a, s.sig)
    defer a.free(sig)
    var got: anyerror = error.None
    rsa.verify_pss(key, .sha256, digest[0..], sig[0..], 9223372036854775807) catch |err| {
        got = err
    }
    t.check(io, got == error.BadSignature, "a salt length of 2^63 - 1")
}

fn key_error(n: []u8, e: str) anyerror {
    _ = rsa.public_key(n, e) catch |err| {
        return err
    }
    return error.None
}

// Made by test/vectors/rsa.rb; do not edit below.
// Keys made by OpenSSL: name, modulus, exponent.
fn keys() [7]Key {
    return [7]Key{
        Key{ .name = "k2048", .n = "", .e = "010001" },
        Key{ .name = "k2049", .n = "", .e = "010001" },
        Key{ .name = "k3072", .n = "", .e = "010001" },
        Key{ .name = "k4096", .n = "", .e = "010001" },
        Key{ .name = "k2048e3", .n = "", .e = "03" },
        Key{ .name = "k8192", .n = "", .e = "010001" },
        Key{ .name = "k1024", .n = "d62b3303902e801427a6c61da77c55f2b2ce847f4a4b75fe4add631c78b3de9c880433bf1f52e7a53d362a3011e51b8d928ac14193c016d503b1542c67d19937338a5973766a17e30002f28618cb422801b9130deaf0d763abfd3523d30cb8e326fce040caa59b622b944e8df05f895988bcb9b15bf20c219c4f0ecac67dab29", .e = "010001" },
    }
}

// Signatures: key, scheme, hash, digest, signature, salt length,
// verifies, name. OpenSSL agreed with each expected answer.
fn sigs() [59]Sig {
    return [59]Sig{
        Sig{ .key = "k2048", .kind = "pkcs1", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 0, .ok = true, .name = "k2048 PKCS#1 v1.5 sha256" },
        Sig{ .key = "k2048", .kind = "pss", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 32, .ok = true, .name = "k2048 PSS sha256" },
        Sig{ .key = "k2048", .kind = "pkcs1", .hash = "sha384", .digest = "71747e331ea6291ceb0b35c1d835045338aa34631f0d2522b0081dd8a327c9920a3687d8f41ae54f9d85835085ad3106", .sig = "", .salt = 0, .ok = true, .name = "k2048 PKCS#1 v1.5 sha384" },
        Sig{ .key = "k2048", .kind = "pss", .hash = "sha384", .digest = "71747e331ea6291ceb0b35c1d835045338aa34631f0d2522b0081dd8a327c9920a3687d8f41ae54f9d85835085ad3106", .sig = "", .salt = 48, .ok = true, .name = "k2048 PSS sha384" },
        Sig{ .key = "k2048", .kind = "pkcs1", .hash = "sha512", .digest = "348959985fb9373969352ccfff2a38c6c540225307edfe6b217710f94a7ea6831059ee5c3a8fa1123495e38e075a7a55c6b37a86aa657d1c80ccb3aaf285dfaa", .sig = "", .salt = 0, .ok = true, .name = "k2048 PKCS#1 v1.5 sha512" },
        Sig{ .key = "k2048", .kind = "pss", .hash = "sha512", .digest = "348959985fb9373969352ccfff2a38c6c540225307edfe6b217710f94a7ea6831059ee5c3a8fa1123495e38e075a7a55c6b37a86aa657d1c80ccb3aaf285dfaa", .sig = "", .salt = 64, .ok = true, .name = "k2048 PSS sha512" },
        Sig{ .key = "k2049", .kind = "pkcs1", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 0, .ok = true, .name = "k2049 PKCS#1 v1.5 sha256" },
        Sig{ .key = "k2049", .kind = "pss", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 32, .ok = true, .name = "k2049 PSS sha256" },
        Sig{ .key = "k2049", .kind = "pkcs1", .hash = "sha384", .digest = "71747e331ea6291ceb0b35c1d835045338aa34631f0d2522b0081dd8a327c9920a3687d8f41ae54f9d85835085ad3106", .sig = "", .salt = 0, .ok = true, .name = "k2049 PKCS#1 v1.5 sha384" },
        Sig{ .key = "k2049", .kind = "pss", .hash = "sha384", .digest = "71747e331ea6291ceb0b35c1d835045338aa34631f0d2522b0081dd8a327c9920a3687d8f41ae54f9d85835085ad3106", .sig = "", .salt = 48, .ok = true, .name = "k2049 PSS sha384" },
        Sig{ .key = "k2049", .kind = "pkcs1", .hash = "sha512", .digest = "348959985fb9373969352ccfff2a38c6c540225307edfe6b217710f94a7ea6831059ee5c3a8fa1123495e38e075a7a55c6b37a86aa657d1c80ccb3aaf285dfaa", .sig = "", .salt = 0, .ok = true, .name = "k2049 PKCS#1 v1.5 sha512" },
        Sig{ .key = "k2049", .kind = "pss", .hash = "sha512", .digest = "348959985fb9373969352ccfff2a38c6c540225307edfe6b217710f94a7ea6831059ee5c3a8fa1123495e38e075a7a55c6b37a86aa657d1c80ccb3aaf285dfaa", .sig = "", .salt = 64, .ok = true, .name = "k2049 PSS sha512" },
        Sig{ .key = "k3072", .kind = "pkcs1", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 0, .ok = true, .name = "k3072 PKCS#1 v1.5 sha256" },
        Sig{ .key = "k3072", .kind = "pss", .hash = "sha256", .digest = "ffda5aa5a3426f912c58d89a3c129bf4692e08254a074d8aca15ba53eec23888", .sig = "", .salt = 32, .ok = true, .name = "k3072 PSS sha256" },
        Sig{ .key = "k3072", .kind = "pkcs1", .hash = "sha384", .digest = "71747e331ea6291ceb0b35c1d835045338aa34631f0d2522b0081dd8a327c9920a3687d8f41ae54f9d85835085ad3106", .sig = "", .salt = 0, .ok = true, .name = "k3072 PKCS#1 v1.5 sha384" },
