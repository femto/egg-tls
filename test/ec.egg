// P-256 and P-384: ECDH against RFC 5903 (both sides) and OpenSSL, public
// keys (n - 1 among them), and ECDSA verification against RFC 6979's
// signatures (SHA-1 to SHA-512, so digests shorter and longer than the
// order) and OpenSSL's, each checked by OpenSSL when the vectors were
// made; then signatures and keys that must be refused, and bad scalars
// and points.
uses io, alloc

const ec = @import("tls/ec")
const ecdsa = @import("tls/ecdsa")
const support = @import("support/check.egg")

const Sig = struct {
    curve: str
    key: str
    digest: str
    der: str
    ok: bool
    name: str
}

const Dh = struct {
    curve: str
    secret: str
    public: str
    peer: str
    shared: str
    name: str
}

fn main(io: Io, a: Allocator) !void {
    var t = support.tally()
    const sigs = ecdsa_vectors()
    for (sigs) |v| {
        try signature(io, a, &t, v)
    }
    const dhs = dh_vectors()
    for (dhs) |v| {
        try exchange(io, a, &t, v)
    }
    try refused(io, a, &t)
    try t.done(io)
}

fn curve_of(name: str) ec.Curve {
    return if (name == "p256") ec.p256() else ec.p384()
}

fn signature(io: Io, a: Allocator, inout t: support.Tally, v: Sig) !void {
    const c = curve_of(v.curve)
    const key = try support.unhex(a, v.key)
    defer a.free(key)
    const digest = try support.unhex(a, v.digest)
    defer a.free(digest)
    const der = try support.unhex(a, v.der)
    defer a.free(der)
    var verified = true
    ecdsa.verify_der(c, key[0..], digest[0..], der[0..]) catch {
        verified = false
    }
    t.check(io, verified == v.ok, v.name)
}

fn exchange(io: Io, a: Allocator, inout t: support.Tally, v: Dh) !void {
    const c = curve_of(v.curve)
    const secret = try support.unhex(a, v.secret)
    defer a.free(secret)
    var public: [97]u8 = @splat(0)
    try ec.public_key(c, secret[0..], &public[0..1 + 2 * c.size])
    t.check_of(io, support.same(a, public[0..1 + 2 * c.size], v.public), "public key:", v.name)
    if (@len(v.peer) == 0) {
        return
    }
    const peer = try support.unhex(a, v.peer)
    defer a.free(peer)
    var shared: [48]u8 = @splat(0)
    try ec.shared(c, secret[0..], peer[0..], &shared[0..c.size])
    t.check_of(io, support.same(a, shared[0..c.size], v.shared), "shared secret:", v.name)
}

// Scalars and points that must be refused.
fn refused(io: Io, a: Allocator, inout t: support.Tally) !void {
    const c = ec.p256()
    var out: [65]u8 = @splat(0)
    const zero: [32]u8 = @splat(0)
    t.check(io, err_of_public(c, zero[0..]) == error.BadScalar, "secret 0")
    const n = try support.unhex(a, "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551")
    defer a.free(n)
    t.check(io, err_of_public(c, n[0..]) == error.BadScalar, "secret n")
    t.check(io, err_of_public(c, n[1..]) == error.BadScalar, "secret of 31 bytes")
    var one: [32]u8 = @splat(0)
    one[31] = 1
    try ec.public_key(c, one[0..], &out[0..])
    // G, from its definition.
    t.check(io, support.same(a, out[0..], "046b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c2964fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5"), "1 G = G")
    // G with its first byte changed is not on the curve; x = p is out of
    // range; a compressed point (0x02) is not taken.
    var bad = out
    bad[1] = bad[1] ^ 1
    t.check(io, err_of_shared(c, one[0..], bad[0..]) == error.BadPoint, "a point off the curve")
    const p_point = try support.unhex(a, "04ffffffff00000001000000000000000000000000ffffffffffffffffffffffff4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5")
    defer a.free(p_point)
    t.check(io, err_of_shared(c, one[0..], p_point[0..]) == error.BadPoint, "x = p")
    var compressed = out
    compressed[0] = 2
    t.check(io, err_of_shared(c, one[0..], compressed[0..]) == error.BadPoint, "a point marked compressed")
    t.check(io, err_of_shared(c, one[0..], out[0..33]) == error.BadPoint, "a point too short")
}

fn err_of_public(c: ec.Curve, secret: []u8) anyerror {
    var out: [97]u8 = @splat(0)
    ec.public_key(c, secret, &out[0..1 + 2 * c.size]) catch |e| {
        return e
    }
    return error.None
}

fn err_of_shared(c: ec.Curve, secret: []u8, peer: []u8) anyerror {
    var out: [48]u8 = @splat(0)
    ec.shared(c, secret, peer, &out[0..c.size]) catch |e| {
        return e
    }
    return error.None
}

