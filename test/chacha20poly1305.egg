    try stream(io, a, &t, "961399b5d3564ca01fc5d16f2a2043da043ac4bdcdcf46866ec83a6f8264e412", 710642710, "c9e4c0231cedca6b6c73b476", "", "", "ChaCha20, 200 bytes")
