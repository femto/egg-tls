// ChaCha20, Poly1305 and ChaCha20-Poly1305 against RFC 8439, and against
// OpenSSL (ChaCha20, the AEAD) and the definition of Poly1305 in Ruby's
// big integers, at lengths around the block sizes and at the edges of
// Poly1305's final reduction.
uses io, alloc

const chacha20 = @import("tls/chacha20")
const poly1305 = @import("tls/poly1305")
const cp = @import("tls/chacha20poly1305")
const support = @import("support/check.egg")

fn main(io: Io, a: Allocator) !void {
    var t = support.tally()
    try block(io, a, &t, "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", 1, "000000090000004a00000000", "10f1e7e4d13b5915500fdd1fa32071c4c7d1f4c733c068030422aa9ac3d46c4ed2826446079faa0914c2d705d98b02a2b5129cd1de164eb9cbd083e8a2503c4e", "RFC 8439 2.3.2")
    try stream(io, a, &t, "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", 1, "000000000000004a00000000", "4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e", "6e2e359a2568f98041ba0728dd0d6981e97e7aec1d4360c20a27afccfd9fae0bf91b65c5524733ab8f593dabcd62b3571639d624e65152ab8f530c359f0861d807ca0dbf500d6a6156a38e088a22b65e52bc514d16ccf806818ce91ab77937365af90bbf74a35be6b40b8eedf2785e42874d", "RFC 8439 2.4.2")
    try stream(io, a, &t, "41f728b0b45849079ba02d52506aaadcceabc7021114a26b1cd8d1a81cb2068c", 406682963, "ff7ece38fbdf38c8fc01fe14", "", "", "ChaCha20, 0 bytes")
    try stream(io, a, &t, "500236aed03eb6534d8b0f8a40fcc6c3c8200b6d4a71e87cb0069ed353ed79b2", 1901771667, "1c2b875fe3a31d173c883b7e", "21", "ee", "ChaCha20, 1 bytes")
    try stream(io, a, &t, "f5aa483175ad9837cc343348e3b3442f97fc3c7040131b7e34947b0cda408b63", 1806980697, "0b2d0a858e475c12acd56b6a", "dab9fc0d3933bd152e6e1bcc2baa93c7ccfbb12967b5c49908e0518ecb1b40e2472b34b7d1e733563b591bd23fb31493f2acf4bac062431d7d88ab473a6810", "ddcf6687e91cc72a19f54466e4d025867a44e364050c2f103b2c35a71c55261180a4a58701f2809e7d8c8d11f54019e2ec1a328766f498f22718a937fa82e8", "ChaCha20, 63 bytes")
    try stream(io, a, &t, "588b1bd5d9f28f3fff45231f3489f89a1a1e1b3d367901db7d6b91157a8c85e8", 1755862076, "0496d5a9ca0d4129515b3b6f", "4224d40f8776b0186f6569fc894984c68c3e0e1b31408f6963bcd570bcd2692472e1ddfe852f45f42087947bb053f52c8643f6c5e4ca460a5cbb1a2f93779947", "638f4258687e8ea203a069727569b8591e3db50929a5b5ff94b1cd205033de750b5c0407d81ff5fa04a50668f89595bec20a4ceca937301e7011dff61d72c8f3", "ChaCha20, 64 bytes")
