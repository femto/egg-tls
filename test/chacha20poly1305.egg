    try mac(io, a, &t, "c5f1adf5f8774eb5fc3a732d0cbea401bdba10932f59127faccc13fbf9446728", "d8763614ea462aed7ee5e41d65f33b", "d3f6a7c2debecaf6d045268e49f351e5", "Poly1305, 15 bytes")
