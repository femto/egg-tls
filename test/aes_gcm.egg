// AES, GHASH and AES-GCM against FIPS 197, the GCM paper's test cases and
// OpenSSL; the S-box circuit against the S-box computed from its
// definition, for all 256 bytes; GHASH against its definition in Ruby's
// big integers.
uses io, alloc

const aes = @import("tls/aes")
const ghash = @import("tls/ghash")
const gcm = @import("tls/aes_gcm")
const support = @import("support/check.egg")

fn main(io: Io, a: Allocator) !void {
    var t = support.tally()
    try sboxes(io, a, &t, "")
    try block128(io, a, &t, "000102030405060708090a0b0c0d0e0f", "00112233445566778899aabbccddeeff", "69c4e0d86a7b0430d8cdb78070b4c55a", "FIPS 197 C.1")
    try block256(io, a, &t, "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", "00112233445566778899aabbccddeeff", "8ea2b7ca516745bfeafc49904b496089", "FIPS 197 C.3")
    try block128(io, a, &t, "0f0e60a05843990e0c9fddffe05d20a2", "ae065b038830ea28e700f0c9a4af8408", "3a58aeb93dc0ab304d0b0d2e45a8af50", "AES-128, random 1")
    try block256(io, a, &t, "bc66a03cffcbc0b85f17826dea93bee700b830bcfd54501b0c6bf5a3f886a055", "8159e22f0e1258e0c717badfe0923949", "e8f7de378230a14c41df1ee41e367534", "AES-256, random 1")
    try block128(io, a, &t, "4f146274ae2cb5e86191099aa455f719", "11953d8cad330b2ad2be4d4ffc4f4003", "b40cb3330e8c9b1a024fdef666b278b0", "AES-128, random 2")
    try block256(io, a, &t, "be63ba07bc22b234c53487dd2de5b5c306d9811d3e8fa8a2235813294ed040d1", "38ee2ee0a79182ba33f380c172fb457f", "23dcef74b876ceb8832fc48fa0f1dc63", "AES-256, random 2")
    try block128(io, a, &t, "998a1bc1af98499504aaf244f66f5b5b", "0c1f6440fd27052618193f97ff37bad7", "ea5cbfeb93f844071e0c4fc124bbf83f", "AES-128, random 3")
    try block256(io, a, &t, "b8f31ac9692feec943e8f0238dd5deeb2f36111ea0fb6b05a63a89cffcedaef1", "8ac054c3445746df8566261d39a46a58", "c58fd916a5680d4b358f88ab8f020332", "AES-256, random 3")
    try block128(io, a, &t, "c96346e80c1e89c47f01158c97a0fb63", "877c0615a45da57ce53dc3aa6cddecf9", "7b31aa7a45a88d8e062b6bcb7cad2637", "AES-128, random 4")
    try block256(io, a, &t, "75ce6f0c776e281ec031870b0797faccd850f3accf00a8e59fc2910ffacf5cb7", "0361c1833ee5c4f5c580a3b5b457f4b5", "4569c86f301f786982d8c7e6f56b4851", "AES-256, random 4")
    try hash(io, a, &t, "1ee07674c28d1d81ed820534b7a1ce4d", "", "00000000000000000000000000000000", "GHASH, 0 bytes")
    try hash(io, a, &t, "747f09c0eaf5181b60b3b7fdc4a08d3d", "eae6392e5739dc0d7ac118f15a90aca8", "29940c2b1c4bc1514f664b5f68edfe7f", "GHASH, 16 bytes")
    try hash(io, a, &t, "4f7306e9f5fbe780f3628233337dd2c8", "35a062f2f7e7c48e13bc45d96534323948", "2969fa53d497961603321712c3bd2ab9", "GHASH, 17 bytes")
    try hash(io, a, &t, "6d7a2769a4c867c29b0847f2b6f0ff5a", "7d0dcbcc89687fb23d575c2a4aaaa7eb2cbc97cfb35b01e949200ef826499e5d56fc121ed967371941cabea4b4f21a00dd3c7323e9bf0a9aadf9181ad6aedb24", "83a6c2378c4c59f307efb463a9dfe53f", "GHASH, 64 bytes")
    try hash(io, a, &t, "eeeb7e358b8463262e64dfbbd6ce2211", "09a47d94c04321b3b897494ba792139baeed4dda15f3d6c8df5dfd7d1ed3258e91af4ec71f2b13b489d8c70b84f10cafb1981dc8cc3869ad48dd3eb3db9308ed3eb4492334b6d594138ea17044cf571af077e29f38bc00ef6479ebd7f5d541e33f559277", "58c4a891f95959dbd4c882dd7dc7d065", "GHASH, 100 bytes")
