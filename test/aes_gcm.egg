    try aead(io, a, &t, "fd39840192fbbbbd9a70c5c523bf476f", "95da696e42ac1c411754d73b", "712f6e95b0bc3dafd2e5a2dbf8382c3a1c", "09dc9afed0111b5a8adb0da25ab7afdb363ad5e8002e80b2bae495c0155ff2f1c337ed6c16e3e04829855c2fd574ea9f1ab66cd8655ee89daf6a4fcb1f0e0ae006e5052e77f446b4717cc7799686e025c22d79ccb15b01923373c4ef0d2501becd1eae2f9e7adda4d4872d2b98253da682696d62afe07c56f143065956f6e158", "1556243dbce329889eef49e437f1043b7fb1d5e3727aa441701dab4690d6e5b62f8b86ef4d1b002564d40851e9b2cc99322f931567edb22c64ce8c807d23aaeff76a51d6bc89712ccdb113cad37cea04aa051de3b3a436580464027a8bfcd6be974da0b06ad97ab33f887bd960fc68322fb35bc672b6bbb75891963fc4665cb0e7a42a6a22761684df7878e1ed4011c3", "AES-128-GCM, 128 bytes, 17 of aad")
