    try aead(io, a, &t, "f54be2a0759d9ce7b27590842c0936946f82a4ef0608221387ead8a2ae33c26e", "62af1c2eeb76de6d5916fb81", "e5ec0f7fddb1cb1b0fb24615f6aa5fe956596d67056e10478dd39b283f52119223", "", "", "AES-256-GCM, 300 bytes, 33 of aad")
    try forged(io, a, &t)
    try t.done(io)
}

fn sboxes(io: Io, a: Allocator, inout t: support.Tally, want: str) !void {
    var got = a.alloc(0, @as(u8, 0))
    defer a.free(got)
    var x: u32 = 0
    while (x < 256) {
        const w = aes.sub_word(x | (x + 1) << 8 | (x + 2) << 16 | (x + 3) << 24)
        a.push(&got, @as(u8, w & 0xFF))
        a.push(&got, @as(u8, (w >> 8) & 0xFF))
        a.push(&got, @as(u8, (w >> 16) & 0xFF))
        a.push(&got, @as(u8, w >> 24))
        x = x + 4
    }
    t.check(io, support.same(a, got[0..], want), "the S-box circuit, all 256 bytes")
}

fn bytes16(a: Allocator, s: str) ![16]u8 {
    if (@len(s) != 32) {
        return error.BadHex
    }
    const b = try support.unhex(a, s)
    defer a.free(b)
    var out: [16]u8 = @splat(0)
    var i = 0
    while (i < 16) {
        out[i] = b[i]
        i = i + 1
    }
    return out
}

fn block128(io: Io, a: Allocator, inout t: support.Tally, key_hex: str, pt_hex: str, want: str, name: str) !void {
    const c = aes.Aes.init128(try bytes16(a, key_hex)).encrypt(try bytes16(a, pt_hex))
    t.check(io, support.same(a, c[0..], want), name)
}

fn block256(io: Io, a: Allocator, inout t: support.Tally, key_hex: str, pt_hex: str, want: str, name: str) !void {
    const c = aes.Aes.init256(try support.bytes32(key_hex)).encrypt(try bytes16(a, pt_hex))
    t.check(io, support.same(a, c[0..], want), name)
}

fn hash(io: Io, a: Allocator, inout t: support.Tally, h_hex: str, data_hex: str, want: str, name: str) !void {
    const data = try support.unhex(a, data_hex)
    defer a.free(data)
    const h = try bytes16(a, h_hex)
    var g = ghash.Ghash.init(h)
    g.update(data[0..])
    const y = g.final()
    t.check(io, support.same(a, y[0..], want), name)
    var p = ghash.Ghash.init(h)
    var at = 0
    while (at < @len(data)) {
        const end = if (@len(data) - at > 7) at + 7 else @len(data)
        p.update(data[at..end])
        at = end
    }
    const again = p.final()
    t.check_of(io, support.same(a, again[0..], want), "in pieces:", name)
}

fn aead(io: Io, a: Allocator, inout t: support.Tally, key_hex: str, nonce_hex: str, aad_hex: str, pt_hex: str, want: str, name: str) !void {
    const g = if (@len(key_hex) == 32) gcm.AesGcm.init128(try bytes16(a, key_hex)) else gcm.AesGcm.init256(try support.bytes32(key_hex))
    const nonce = try support.bytes12(nonce_hex)
    const aad = try support.unhex(a, aad_hex)
    defer a.free(aad)
    var buf = try support.unhex(a, pt_hex)
    defer a.free(buf)
    const n = @len(buf)
    var i = 0
    while (i < 16) {
        a.push(&buf, 0)
        i = i + 1
    }
    g.seal(nonce, aad[0..], &buf[0..])
    t.check_of(io, support.same(a, buf[0..], want), "seal:", name)
    var opened = true
    g.open(nonce, aad[0..], &buf[0..]) catch {
        opened = false
    }
    t.check_of(io, opened and support.same(a, buf[0..n], pt_hex), "open:", name)
}

// A changed bit anywhere, other additional data or another nonce fails,
// and leaves only zeros.
fn forged(io: Io, a: Allocator, inout t: support.Tally) !void {
    const key: [32]u8 = @splat(0x42)
    const g = gcm.AesGcm.init256(key)
    const nonce: [12]u8 = @splat(7)
    const aad = "header"
    var sealed = a.alloc(0, @as(u8, 0))
    defer a.free(sealed)
    a.append_str(&sealed, "attack at dawn, bring snacks")
    var i = 0
    while (i < 16) {
        a.push(&sealed, 0)
        i = i + 1
    }
    g.seal(nonce, aad, &sealed[0..])
    var at = 0
    var all_fail = true
    var all_zero = true
    while (at < @len(sealed)) {
        var bad = a.concat(sealed[0..], "")
        defer a.free(bad)
        bad[at] = bad[at] ^ 0x80
        var failed = false
        g.open(nonce, aad, &bad[0..]) catch {
            failed = true
        }
        all_fail = all_fail and failed
        for (bad) |b| {
            all_zero = all_zero and b == 0
        }
        at = at + 1
    }
    t.check(io, all_fail, "a changed bit of the ciphertext or tag fails")
    t.check(io, all_zero, "a failed open leaves only zeros")
    var copy = a.concat(sealed[0..], "")
    defer a.free(copy)
    var failed = false
    g.open(nonce, "headex", &copy[0..]) catch {
        failed = true
    }
    t.check(io, failed, "other additional data fails")
    var copy2 = a.concat(sealed[0..], "")
    defer a.free(copy2)
    var other: [12]u8 = @splat(7)
    other[0] = 8
    failed = false
    g.open(other, aad, &copy2[0..]) catch {
        failed = true
    }
    t.check(io, failed, "another nonce fails")
    var short: [15]u8 = @splat(0)
    failed = false
    g.open(nonce, aad, &short[0..]) catch {
        failed = true
    }
    t.check(io, failed, "fewer than 16 bytes fails")
}
