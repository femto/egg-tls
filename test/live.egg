// The client against a real TLS 1.3 server: test/live.sh starts
// `openssl s_server -www` once per cipher suite and runs this with
// EGG_TLS_PORT and EGG_TLS_SUITE set. Without them it does nothing, so
// plain `clutch test` passes without openssl. With EGG_TLS_SHA256 too,
// the server is `s_server -HTTP`, which sends the file big.bin as it is,
// and what arrives must have that SHA-256.
//
// With EGG_TLS_CA, the PEM of the test CA, the client checks the server
// (tls.client) for EGG_TLS_HOST (localhost by default); with
// EGG_TLS_EXPECT too, connecting must fail with that error.
uses io, alloc, args, net, rand, fs, time

const tls = @import("tls")
const record = @import("tls/record")
const sha256 = @import("tls/sha256")
const x509 = @import("tls/x509")
const roots = @import("tls/roots")

fn main(io: Io, a: Allocator, args: Args, net: Net, rng: Random, files: Fs, clock: Clock) !void {
    const port_text = args.env("EGG_TLS_PORT") orelse return
    const want = args.env("EGG_TLS_SUITE") orelse return
    const port = number(port_text)
    const want_sha = args.env("EGG_TLS_SHA256") orelse ""
    const ca_path = args.env("EGG_TLS_CA") orelse ""
    var trusted = x509.CertList.empty()
    defer a.free(trusted)
    if (@len(ca_path) > 0) {
        const pem = try files.read(a, ca_path)
        defer a.free(pem)
        // A CA that did not load would make "a CA not trusted" pass for
        // the wrong reason.
        const skipped = try roots.add_pem(a, &trusted, pem)
        if (trusted.len() == 0 or skipped > 0) {
            io.print("FAIL the CA in ", ca_path, " did not load")
            return error.Failed
        }
    }
    const conn = try net.tcp_connect("127.0.0.1", port)
    const host = args.env("EGG_TLS_HOST") orelse "localhost"
    const expect = args.env("EGG_TLS_EXPECT") orelse ""
    var c = connect(a, rng, clock, trusted, conn, host, @len(ca_path) > 0) catch |e| {
        if (@len(expect) > 0 and @errorName(e) == expect) {
            io.print("refused: ", expect)
            return
        }
        return e
    }
    defer c.close(a)
    if (@len(expect) > 0) {
        io.print("FAIL connected; wanted ", expect)
        return error.Failed
    }
    const got = suite_name(c.suite())
    if (@len(want_sha) > 0) {
        try c.write(a, "GET /big.bin HTTP/1.0\r\n\r\n")
    } else {
        try c.write(a, "GET / HTTP/1.0\r\n\r\n")
    }
    var response: Buf(u8) = .empty
    defer a.free(response)
    var buf: Buf(u8) = .empty
    defer a.free(buf)
    while (try c.read(a, &buf, 65536) > 0) {
        a.append_str(&response, buf)
    }
    io.print("suite ", got, ", ", @len(response), " bytes")
    if (!(got == want)) {
        io.print("FAIL wanted ", want)
        return error.Failed
    }
    if (@len(want_sha) > 0) {
        // -HTTP sends the file as it is, as the whole response.
        const d = sha256.sum(response[0..])
        var hex: Buf(u8) = .empty
        defer a.free(hex)
        const digits = "0123456789abcdef"
        for (d) |x| {
            a.push(&hex, digits[@as(i64, x >> 4)])
            a.push(&hex, digits[@as(i64, x & 15)])
        }
        if (!(hex == want_sha)) {
            io.print("FAIL got SHA-256 ", hex, ", wanted ", want_sha)
            return error.Failed
        }
        return
    }
    // s_server -www answers with a page about the connection.
    if (!starts_with(response[0..], "HTTP/1.0 200 ok") or !contains(response[0..], want)) {
        io.print("FAIL response:")
        io.print(response)
        return error.Failed
    }
}

fn connect(a: Allocator, rng: Random, clock: Clock, trusted: x509.CertList, sink conn: TcpConn, host: []u8, verify: bool) !tls.TlsConn {
    if (verify) {
        return tls.client(a, rng, clock, trusted, conn, host)
    }
    return tls.client_unverified(a, rng, conn, host)
}

fn number(text: str) i64 {
    var n = 0
    for (text) |ch| {
        n = n * 10 + @as(i64, ch - '0')
    }
    return n
}

fn suite_name(s: record.Suite) str {
    switch (s) {
        .chacha20_poly1305_sha256 => {
            return "TLS_CHACHA20_POLY1305_SHA256"
        }
        .aes_128_gcm_sha256 => {
            return "TLS_AES_128_GCM_SHA256"
        }
        .aes_256_gcm_sha384 => {
            return "TLS_AES_256_GCM_SHA384"
        }
    }
}

fn starts_with(s: []u8, p: str) bool {
    return @len(s) >= @len(p) and s[0..@len(p)] == p
}

fn contains(s: []u8, p: str) bool {
    var i = 0
    while (i + @len(p) <= @len(s)) {
        if (s[i..i + @len(p)] == p) {
            return true
        }
        i = i + 1
    }
    return false
}
