// Chains verified against a test PKI made by OpenSSL: RSA and EC (P-256,
// P-384) roots, intermediates and leaves, signed with SHA-256, -384 and
// -512, and chains that must fail: expired, not yet valid, unknown or
// untrusted issuers, a changed signature, intermediates that are not CAs
// or may not sign, pathLenConstraint, extKeyUsage and keyUsage, unknown
// critical extensions, host names (wildcards, IPv4, IPv6, case), and too
// long a chain; and certificates made wrong on purpose, which DER and RFC
// 5280 refuse. OpenSSL's verifier agreed with each answer, for the same
// reason, when the vectors were made (test/vectors/x509.rb), except where
// a case says how tls/x509 differs from it. Then roots from PEM (tls/roots), with a
// block that is no certificate, and PEM that must be refused.
uses io, alloc

const x509 = @import("tls/x509")
const roots_pem = @import("tls/roots")
const support = @import("support/check.egg")

const Named = struct {
    name: str
    der: str
}

const Case = struct {
    name: str
    chain: str
    roots: str
    host: str
    now: i64
    want: str
}

fn main(io: Io, a: Allocator) !void {
    var t = support.tally()
    const all = certs()
    const cs = cases()
    for (cs) |c| {
        var chain = x509.CertList.empty()
        defer a.free(chain)
        var roots = x509.CertList.empty()
        defer a.free(roots)
        // A certificate that does not parse fails here, as BadDer.
        var got: anyerror = error.None
        fill(a, &chain, all[0..], c.chain) catch |e| {
            got = e
        }
        if (got == error.None) {
            try fill(a, &roots, all[0..], c.roots)
            x509.verify(chain, roots, c.host, c.now) catch |e| {
                got = e
            }
        }
        const ok = if (c.want == "ok") got == error.None else @errorName(got) == c.want
        t.check(io, ok, c.name)
        if (!ok) {
            io.print("  got ", @errorName(got), ", want ", c.want)
        }
    }
    try pem(io, a, &t, all[0..])
    try t.done(io)
}

fn pem(io: Io, a: Allocator, inout t: support.Tally, all: []Named) !void {
    var roots = x509.CertList.empty()
    defer a.free(roots)
    const skipped = try roots_pem.add_pem(a, &roots, PEM)
    t.check(io, roots.len() == 2 and skipped == 1, "PEM: two roots, one block skipped")
    var chain = x509.CertList.empty()
    defer a.free(chain)
    try fill(a, &chain, all, "leaf,inter")
    var ok = true
    x509.verify(chain, roots, "example.com", 1893456000) catch {
        ok = false
    }
    t.check(io, ok, "PEM: a chain to a root read from PEM")
    t.check(io, pem_error(a, "-----BEGIN CERTIFICATE-----\nMII@\n-----END CERTIFICATE-----\n") == error.BadPem, "PEM: a character not in base64")
    t.check(io, pem_error(a, "-----BEGIN CERTIFICATE-----\nMIIC\n") == error.BadPem, "PEM: no END line")
    t.check(io, pem_error(a, "-----BEGIN CERTIFICATE-----\nAB=C\n-----END CERTIFICATE-----\n") == error.BadPem, "PEM: = before the end")
    t.check(io, pem_error(a, "-----BEGIN CERTIFICATE-----\nAA==\n-----END CERTIFICATE-----\n") == error.None, "PEM: well-formed base64 that is no certificate: skipped")
    t.check(io, pem_error(a, "-----BEGIN CERTIFICATE-----\nAB==\n-----END CERTIFICATE-----\n") == error.BadPem, "PEM: padding bits that are not zero")
    t.check(io, pem_error(a, "nothing here\n") == error.None, "PEM: no certificates")
}

fn pem_error(a: Allocator, text: str) anyerror {
    var list = x509.CertList.empty()
    defer a.free(list)
    _ = roots_pem.add_pem(a, &list, text) catch |e| {
        return e
    }
    return error.None
}

// The certificates named in names, "a,b,c", in that order.
fn fill(a: Allocator, inout list: x509.CertList, all: []Named, names: str) !void {
    var at = 0
    while (at <= @len(names)) {
        var end = at
        while (end < @len(names) and names[end] != ',') {
            end = end + 1
        }
        const name = names[at..end]
        var found = false
        for (all) |n| {
            if (n.name == name) {
                const bytes = try support.unhex(a, n.der)
                defer a.free(bytes)
                try list.add(a, bytes[0..])
                found = true
            }
        }
        if (!found) {
            return error.NoSuchCertificate
        }
        at = end + 1
    }
}

// Made by test/vectors/x509.rb; do not edit below.
// The test PKI: name, DER.
fn certs() [51]Named {
    return [51]Named{
        Named{ .name = "root_rsa", .der = "" },
        Named{ .name = "root_ec", .der = "" },
        Named{ .name = "inter", .der = "" },
        Named{ .name = "inter2", .der = "" },
        Named{ .name = "leaf", .der = "" },
        Named{ .name = "leaf_rsa", .der = "" },
        Named{ .name = "leaf_sha512", .der = "" },
        Named{ .name = "leaf_bad_sig", .der = "" },
        Named{ .name = "leaf_client", .der = "" },
        Named{ .name = "leaf_ku_sign", .der = "" },
        Named{ .name = "leaf_critical", .der = "" },
        Named{ .name = "leaf_tld_wild", .der = "" },
        Named{ .name = "leaf_no_san", .der = "" },
        Named{ .name = "leaf_no_bc", .der = "" },
        Named{ .name = "self_signed", .der = "" },
        Named{ .name = "inter_not_ca", .der = "" },
        Named{ .name = "inter_no_bc", .der = "" },
        Named{ .name = "inter_ku", .der = "" },
        Named{ .name = "inter_client", .der = "" },
        Named{ .name = "inter_nc", .der = "" },
        Named{ .name = "inter_expired", .der = "" },
        Named{ .name = "root_len0", .der = "" },
        Named{ .name = "inter_under_len0", .der = "" },
        Named{ .name = "inter_b", .der = "" },
        Named{ .name = "leaf_under_b", .der = "" },
        Named{ .name = "inter_c", .der = "" },
        Named{ .name = "leaf_under_c", .der = "" },
        Named{ .name = "leaf_edge", .der = "" },
        Named{ .name = "root_long", .der = "" },
        Named{ .name = "leaf_long", .der = "" },
        Named{ .name = "other_root", .der = "" },
        Named{ .name = "bad_tag0", .der = "" },
        Named{ .name = "bad_gentime", .der = "" },
        Named{ .name = "bad_version0", .der = "" },
        Named{ .name = "bad_version3", .der = "" },
        Named{ .name = "bad_version_extra", .der = "" },
        Named{ .name = "bad_serial_negative", .der = "" },
        Named{ .name = "bad_serial_long_form", .der = "" },
        Named{ .name = "bad_pathlen_leaf", .der = "" },
        Named{ .name = "bad_duplicate_san", .der = "" },
        Named{ .name = "bad_ku_unused_bits", .der = "" },
        Named{ .name = "bad_ku_too_long", .der = "" },
        Named{ .name = "bad_oid", .der = "" },
        Named{ .name = "bad_policies", .der = "" },
        Named{ .name = "bad_ext_wrapper", .der = "" },
        Named{ .name = "bad_many_extensions", .der = "" },
        Named{ .name = "bad_policy_twice", .der = "" },
        Named{ .name = "bad_policy_qualifier", .der = "" },
        Named{ .name = "bad_policy_no_qualifiers", .der = "" },
        Named{ .name = "ok_ku", .der = "" },
        Named{ .name = "ok_policies", .der = "" },
    }
}

// Chains: name, certificates (leaf first), roots, host, time, answer.
fn cases() [63]Case {
    return [63]Case{
        Case{ .name = "certificatePolicies with a CPS qualifier", .chain = "ok_policies,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "ok" },
        Case{ .name = "more than 64 extensions (unlike OpenSSL: OpenSSL has no limit; a limit keeps the check for repeats small)", .chain = "bad_many_extensions,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadDer" },
        Case{ .name = "a policy twice (unlike OpenSSL: OpenSSL does not parse policies it is not asked about)", .chain = "bad_policy_twice,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadDer" },
        Case{ .name = "a policy qualifier without its OID (unlike OpenSSL: OpenSSL does not parse policies it is not asked about)", .chain = "bad_policy_qualifier,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadDer" },
        Case{ .name = "an empty list of policy qualifiers (unlike OpenSSL: OpenSSL does not parse policies it is not asked about)", .chain = "bad_policy_no_qualifiers,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadDer" },
        Case{ .name = "keyUsage with a trailing zero byte", .chain = "ok_ku,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "ok" },
        Case{ .name = "an element with tag 0 (end-of-contents) in subjectAltName (unlike OpenSSL: OpenSSL takes a SAN entry it does not know)", .chain = "bad_tag0,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadDer" },
        Case{ .name = "GeneralizedTime before 2050 (unlike OpenSSL: OpenSSL takes either kind of time for any year)", .chain = "bad_gentime,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadDer" },
        Case{ .name = "version v1 written out (unlike OpenSSL: OpenSSL takes a default written out, and extensions in a v1 certificate)", .chain = "bad_version0,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadDer" },
        Case{ .name = "version 4 (3) (unlike OpenSSL: OpenSSL takes versions it does not know)", .chain = "bad_version3,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadDer" },
        Case{ .name = "something after the version", .chain = "bad_version_extra,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadDer" },
        Case{ .name = "a negative serial number (unlike OpenSSL: OpenSSL takes negative serials (Go 1.23 refuses them))", .chain = "bad_serial_negative,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadDer" },
        Case{ .name = "a serial number with a needless zero", .chain = "bad_serial_long_form,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadDer" },
        Case{ .name = "pathLenConstraint on a leaf (unlike OpenSSL: OpenSSL takes it)", .chain = "bad_pathlen_leaf,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadDer" },
        Case{ .name = "subjectAltName twice", .chain = "bad_duplicate_san,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadDer" },
        Case{ .name = "keyUsage with unused bits set (unlike OpenSSL: OpenSSL ignores the unused bits)", .chain = "bad_ku_unused_bits,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadDer" },
        Case{ .name = "keyUsage of more than nine bits (unlike OpenSSL: OpenSSL takes it)", .chain = "bad_ku_too_long,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadDer" },
        Case{ .name = "an extension OID not in canonical form", .chain = "bad_oid,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadDer" },
        Case{ .name = "certificatePolicies that do not parse (unlike OpenSSL: OpenSSL does not parse policies it is not asked about)", .chain = "bad_policies,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadDer" },
        Case{ .name = "something after the extensions", .chain = "bad_ext_wrapper,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadDer" },
        Case{ .name = "EC leaf, EC intermediate, RSA root", .chain = "leaf,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "ok" },
        Case{ .name = "RSA leaf, P-384 intermediate and root (SHA-384)", .chain = "leaf_rsa,inter2", .roots = "root_ec", .host = "example.com", .now = 1893456000, .want = "ok" },
        Case{ .name = "signed with SHA-512", .chain = "leaf_sha512,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "ok" },
        Case{ .name = "host in another case, and a final dot (unlike OpenSSL: Ruby's host check takes no final dot)", .chain = "leaf,inter", .roots = "root_rsa", .host = "EXAMPLE.Com.", .now = 1893456000, .want = "ok" },
        Case{ .name = "wildcard", .chain = "leaf,inter", .roots = "root_rsa", .host = "a.wild.example", .now = 1893456000, .want = "ok" },
        Case{ .name = "wildcard: two labels", .chain = "leaf,inter", .roots = "root_rsa", .host = "a.b.wild.example", .now = 1893456000, .want = "HostMismatch" },
        Case{ .name = "wildcard: no label", .chain = "leaf,inter", .roots = "root_rsa", .host = "wild.example", .now = 1893456000, .want = "HostMismatch" },
        Case{ .name = "wildcard: an empty label", .chain = "leaf,inter", .roots = "root_rsa", .host = ".wild.example", .now = 1893456000, .want = "HostMismatch" },
        Case{ .name = "wildcard with one label after it (unlike OpenSSL: Ruby's host check takes *.example; tls/x509 wants two labels after the *, so *.com cannot match)", .chain = "leaf_tld_wild,inter", .roots = "root_rsa", .host = "a.example", .now = 1893456000, .want = "HostMismatch" },
        Case{ .name = "another host", .chain = "leaf,inter", .roots = "root_rsa", .host = "example.org", .now = 1893456000, .want = "HostMismatch" },
        Case{ .name = "IPv4", .chain = "leaf,inter", .roots = "root_rsa", .host = "127.0.0.1", .now = 1893456000, .want = "ok" },
        Case{ .name = "IPv6", .chain = "leaf,inter", .roots = "root_rsa", .host = "::1", .now = 1893456000, .want = "ok" },
        Case{ .name = "IPv6, long form", .chain = "leaf,inter", .roots = "root_rsa", .host = "0:0:0:0:0:0:0:1", .now = 1893456000, .want = "ok" },
        Case{ .name = "another IP", .chain = "leaf,inter", .roots = "root_rsa", .host = "127.0.0.2", .now = 1893456000, .want = "HostMismatch" },
        Case{ .name = "no subjectAltName (no common name fallback) (unlike OpenSSL: OpenSSL falls back to the common name)", .chain = "leaf_no_san,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "HostMismatch" },
        Case{ .name = "valid to its last second (unlike OpenSSL: OpenSSL takes notAfter's own second as expired; RFC 5280 (4.1.2.5) includes it, as Go does)", .chain = "leaf_edge,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "ok" },
        Case{ .name = "expired by a second", .chain = "leaf_edge,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456001, .want = "Expired" },
        Case{ .name = "GeneralizedTime, valid", .chain = "leaf_long", .roots = "root_long", .host = "example.com", .now = 2537654400, .want = "ok" },
        Case{ .name = "GeneralizedTime, a second after", .chain = "leaf_long", .roots = "root_long", .host = "example.com", .now = 2561284801, .want = "Expired" },
        Case{ .name = "UTCTime 2049 to GeneralizedTime, a second before", .chain = "leaf_long", .roots = "root_long", .host = "example.com", .now = 2524607998, .want = "NotYetValid" },
        Case{ .name = "expired", .chain = "leaf,inter", .roots = "root_rsa", .host = "example.com", .now = 2240611200, .want = "Expired" },
        Case{ .name = "not yet valid", .chain = "leaf,inter", .roots = "root_rsa", .host = "example.com", .now = 1546300800, .want = "NotYetValid" },
        Case{ .name = "intermediate expired", .chain = "leaf,inter_expired", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "Expired" },
        Case{ .name = "no intermediate", .chain = "leaf", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "UnknownIssuer" },
        Case{ .name = "untrusted root", .chain = "leaf,inter", .roots = "root_ec", .host = "example.com", .now = 1893456000, .want = "UnknownIssuer" },
        Case{ .name = "root of the same name, another key (unlike OpenSSL: OpenSSL also matches issuers by key identifier, so it finds none: unknown issuer)", .chain = "leaf,inter", .roots = "other_root", .host = "example.com", .now = 1893456000, .want = "BadSignature" },
        Case{ .name = "out of order (unlike OpenSSL: OpenSSL builds its own path)", .chain = "leaf,inter2,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "UnknownIssuer" },
        Case{ .name = "leaf signature changed", .chain = "leaf_bad_sig,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadSignature" },
        Case{ .name = "intermediate not a CA", .chain = "leaf,inter_not_ca", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "NotCA" },
        Case{ .name = "intermediate without basicConstraints", .chain = "leaf,inter_no_bc", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "NotCA" },
        Case{ .name = "intermediate without keyCertSign", .chain = "leaf,inter_ku", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadKeyUsage" },
        Case{ .name = "intermediate for clients only", .chain = "leaf,inter_client", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadExtKeyUsage" },
        Case{ .name = "intermediate with critical nameConstraints (unlike OpenSSL: OpenSSL supports nameConstraints)", .chain = "leaf,inter_nc", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "UnknownCriticalExtension" },
        Case{ .name = "leaf for clients only", .chain = "leaf_client,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadExtKeyUsage" },
        Case{ .name = "leaf without digitalSignature", .chain = "leaf_ku_sign,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "BadKeyUsage" },
        Case{ .name = "leaf with an unknown critical extension", .chain = "leaf_critical,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "UnknownCriticalExtension" },
        Case{ .name = "leaf without basicConstraints", .chain = "leaf_no_bc,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "ok" },
        Case{ .name = "pathLenConstraint 0 on the root, two intermediates", .chain = "leaf_under_b,inter_b,inter_under_len0", .roots = "root_len0", .host = "example.com", .now = 1893456000, .want = "PathLenExceeded" },
        Case{ .name = "pathLenConstraint 0 on the intermediate, a CA under it", .chain = "leaf_under_c,inter_c,inter", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "PathLenExceeded" },
        Case{ .name = "a self-signed leaf trusted as a root", .chain = "self_signed", .roots = "self_signed", .host = "example.com", .now = 1893456000, .want = "ok" },
        Case{ .name = "a self-signed leaf not trusted", .chain = "self_signed", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "UnknownIssuer" },
        Case{ .name = "the root sent too", .chain = "leaf,inter,root_rsa", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "ok" },
        Case{ .name = "eleven certificates (unlike OpenSSL: OpenSSL has no such limit)", .chain = "leaf,inter,leaf,inter,leaf,inter,leaf,inter,leaf,inter,leaf", .roots = "root_rsa", .host = "example.com", .now = 1893456000, .want = "ChainTooLong" },
    }
}

// Two roots in PEM, and a block that is no certificate.
const PEM = "Bundle\n-----BEGIN CERTIFICATE-----\nMIIC7TCCAdWgAwIBAgIBATANBgkqhkiG9w0BAQsFADAYMRYwFAYDVQQDDA1UZXN0\nIFJTQSBSb290MB4XDTIwMDEwMTAwMDAwMFoXDTQwMDEwMTAwMDAwMFowGDEWMBQG\nA1UEAwwNVGVzdCBSU0EgUm9vdDCCASIwDQYJKoZIhvcNAQEBBQADggEPADCCAQoC\nggEBAMKfW+UCzbg0ng0v+S0+lhQkJ6X5RnE3KdAfGMwDbmlrSxWVOtPhKEaYSmGx\njwA+dAaz48PNiR3vcpClVFLxjNZf8FMr/mQIDcuC7TKAHvnOcyBrLOaizri9zIGc\nwVPIqUxQNzrpUJVE06kd2OvDzCpm42VjfweeENxcf/qAvnsRmjf2gpNA1DKQwnWS\nagG1t/78y4LxvoGXyGvMfgV+Nd3/Zuuin6mq8JmeE/uwSA6TSPMpak9Z7RvQt1e4\ni57C2KeAAqL4krLcEF2XEner/7O3oTiYxcL858646kB7YLMqR1Od2gcWx1D08Dn+\nnCcEXl55l5SBXm4zxpm+2NxOrLsCAwEAAaNCMEAwDwYDVR0TAQH/BAUwAwEB/zAO\nBgNVHQ8BAf8EBAMCAQYwHQYDVR0OBBYEFNcrPiaoj82stZlHhUInFmiS4gsNMA0G\nCSqGSIb3DQEBCwUAA4IBAQBdU28i2FbQhWtrFXOG197LCrpNGbgMonhvAXzla8Ev\nsbD6Qr3TkC05Fb3u+I85MJsSTmh5NNOjqyoIhfygmhp2spx3dAXanM0+g0dxQKpm\nPzIuDDzkZISIzFxFtqZP+PkXyYzox4OdwnRGSb7B3bjQ90Px3DtED0nigl27FMn1\nJCXfFiGY+yMlXjxQ9JVwnpqgVUjUsOHcbkED4yaMetD4hU83AsZJNiji3MZc/j6a\njodOH7Py9RCEJwgjPR5xUN8fMhezLSRgcCbGEEmTmRw7a50tnxcAGyLZXNt5zBfL\nR1bWBXfa3xLfu7emX4za7/hioG7ER6WZqYOO6YSDHPut\n-----END CERTIFICATE-----\n-----BEGIN CERTIFICATE-----\nAAECAwQF\n-----END CERTIFICATE-----\n# a comment\n-----BEGIN CERTIFICATE-----\nMIIBnDCCASKgAwIBAgIBAjAKBggqhkjOPQQDAzAXMRUwEwYDVQQDDAxUZXN0IEVD\nIFJvb3QwHhcNMjAwMTAxMDAwMDAwWhcNNDAwMTAxMDAwMDAwWjAXMRUwEwYDVQQD\nDAxUZXN0IEVDIFJvb3QwdjAQBgcqhkjOPQIBBgUrgQQAIgNiAAR3D6/7MMumt41H\neT51OBsyORUktsrq6FqgKM2Z8LaNCplS2AMdCQivTv1agBDrtWIsN4oIUMj/0EuC\nYwBSIq22x809qm3qoC/MDQ0b1hPIAFFfcIsmAosJ+uwaz6CO/CCjQjBAMA8GA1Ud\nEwEB/wQFMAMBAf8wDgYDVR0PAQH/BAQDAgEGMB0GA1UdDgQWBBScDWMbrMRNl8g9\nSrrsiFNzQx0G/zAKBggqhkjOPQQDAwNoADBlAjBzcw+54RV3pJ+hp2+Y/cO5a53v\ngGPVPlamlHNo7kOWplbm3Dq3MQ87pJR3V33FbvUCMQCTIvlbSj74XqeJTAbrHjTe\nXI/xXQl7LP0Y4BvCkgrx/9T+J421DFNDMPUMhCQpEhI=\n-----END CERTIFICATE-----\n"
