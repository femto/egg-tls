// HelloRetryRequest. RFC 8448 section 5 replayed: the client sends the
// RFC's first ClientHello and, after the server's HelloRetryRequest (for
// P-256, with a cookie), the RFC's second one; every record it sends after
// that (Finished, close_notify) must be the RFC's, byte for byte, which
// needs the transcript restarted as message_hash. Whole and a byte at a
// time, and with a ChangeCipherSpec after the HelloRetryRequest. Then the
// second ClientHello tls/client builds itself, for P-384 with a cookie and
// for a cookie alone, against ones built by hand; and HelloRetryRequests
// and ServerHellos it must refuse. test/vectors/rfc8448.rb made the
// vectors.
uses io, alloc

const client = @import("tls/client")
const support = @import("support/check.egg")

fn main(io: Io, a: Allocator) !void {
    var t = support.tally()
    try replay(io, a, &t, false, false)
    try replay(io, a, &t, true, false)
    try replay(io, a, &t, false, true)
    try ccs_first(io, a, &t)
    try built(io, a, &t, HRR_P384, REC_OUR_CH2, "our second ClientHello: P-384 and a cookie")
    try built(io, a, &t, HRR_COOKIE_ONLY, REC_OUR_CH2_COOKIE, "our second ClientHello: a cookie alone")
    try refused(io, a, &t, HRR_OFFERED, "", error.IllegalParameter, "a group already shared")
    try refused(io, a, &t, HRR_UNKNOWN_GROUP, "", error.IllegalParameter, "a group not offered")
    try refused(io, a, &t, HRR_GROUP0_COOKIE, "", error.IllegalParameter, "group 0, with a cookie")
    try refused(io, a, &t, HRR_NO_CHANGE, "", error.IllegalParameter, "nothing to change")
    try refused(io, a, &t, HRR_NO_VERSION, "", error.ProtocolVersion, "no supported_versions")
    try refused(io, a, &t, HRR_BAD_SUITE, "", error.IllegalParameter, "a suite not offered")
    try refused(io, a, &t, HRR_UNKNOWN_EXT, "", error.UnsupportedExtension, "an extension not offered")
    try refused(io, a, &t, HRR_P384, HRR_P384, error.UnexpectedMessage, "a second HelloRetryRequest")
    try after_retry(io, a, &t, REC_SH_OTHER_SUITE, "ServerHello: another suite than the HelloRetryRequest's")
    try after_retry(io, a, &t, REC_SH_X25519, "ServerHello: a share the second ClientHello did not carry")
    try t.done(io)
}

// RFC 8448's secrets: X25519 for the first ClientHello, P-256 for the
// second; P-384 unused.
fn rfc_shares() !client.Shares {
    var p384: [48]u8 = @splat(0)
    p384[47] = 7
    return client.Shares{ .x25519 = try support.bytes32(X_PRIV), .p256 = try support.bytes32(P_PRIV), .p384 = p384 }
}

// The shares tls/client's own ClientHellos are built with (see the script).
fn our_shares() !client.Shares {
    var p384: [48]u8 = @splat(0)
    p384[47] = 7
    return client.Shares{ .x25519 = try support.bytes32(X_PRIV3), .p256 = try support.bytes32(P256_PRIV), .p384 = p384 }
}

fn replay(io: Io, a: Allocator, inout t: support.Tally, bytewise: bool, ccs: bool) !void {
    const name = if (bytewise) "a byte at a time" else if (ccs) "a ChangeCipherSpec after the HelloRetryRequest" else "whole records"
    const ch1 = try support.unhex(a, CH1)
    defer a.free(ch1)
    var c = client.Client.start_with(a, try rfc_shares(), ch1[0..])
    defer c.deinit(a)
    try sent(io, a, &t, &c, REC_CH1, "first ClientHello", name)
    const ch2 = try support.unhex(a, CH2)
    defer a.free(ch2)
    c.replay_retry(a, ch2[0..])
    try give(a, &c, REC_HRR, bytewise)
    try sent(io, a, &t, &c, REC_CH2, "second ClientHello record", name)
    if (ccs) {
        try give(a, &c, "140303000101", false)
    }
    try give(a, &c, REC_SH, bytewise)
    try give(a, &c, REC_FLIGHT, bytewise)
    t.check_of(io, c.connected(), "connected:", name)
    try sent(io, a, &t, &c, REC_CFIN, "client Finished record", name)
    c.close_notify(a)
    try sent(io, a, &t, &c, REC_CALERT, "close_notify record", name)
    try give(a, &c, REC_SALERT, bytewise)
    t.check_of(io, c.closed() and c.alert() == 0, "closed by close_notify:", name)
}

// A ChangeCipherSpec before the HelloRetryRequest is dropped too (RFC
// 8446, 5: at any time after the first ClientHello).
fn ccs_first(io: Io, a: Allocator, inout t: support.Tally) !void {
    const ch1 = try support.unhex(a, CH1)
    defer a.free(ch1)
    var c = client.Client.start_with(a, try rfc_shares(), ch1[0..])
    defer c.deinit(a)
    a.free(c.take_outbox())
    const ch2 = try support.unhex(a, CH2)
    defer a.free(ch2)
    c.replay_retry(a, ch2[0..])
    try give(a, &c, "140303000101", false)
    try give(a, &c, REC_HRR, false)
    try sent(io, a, &t, &c, REC_CH2, "second ClientHello record", "a ChangeCipherSpec before the HelloRetryRequest")
}

// Our client, then a HelloRetryRequest: the second ClientHello it sends.
fn built(io: Io, a: Allocator, inout t: support.Tally, hrr: str, want: str, name: str) !void {
    var c = try ours(a)
    defer c.deinit(a)
    try sent(io, a, &t, &c, REC_OUR_CH, "first ClientHello:", name)
    try give(a, &c, hrr, false)
    try sent(io, a, &t, &c, want, "second ClientHello:", name)
}

fn ours(a: Allocator) !client.Client {
    var random: [32]u8 = @splat(0)
    var i = 0
    while (i < 32) {
        random[i] = @as(u8, i)
        i = i + 1
    }
    return client.Client.start(a, try our_shares(), random, "example.com")
}

// Our client, given first then (if not empty) second: refused with want.
fn refused(io: Io, a: Allocator, inout t: support.Tally, first: str, second: str, want: anyerror, name: str) !void {
    var c = try ours(a)
    defer c.deinit(a)
    a.free(c.take_outbox())
    var got: anyerror = error.None
    give(a, &c, first, false) catch |e| {
        got = e
    }
    if (got == error.None and @len(second) > 0) {
        give(a, &c, second, false) catch |e| {
            got = e
        }
    }
    t.check(io, got == want, name)
    if (got != want) {
        io.print("  got ", @errorName(got))
    }
}

// The RFC's handshake up to its HelloRetryRequest, then sh: refused.
fn after_retry(io: Io, a: Allocator, inout t: support.Tally, sh: str, name: str) !void {
    const ch1 = try support.unhex(a, CH1)
    defer a.free(ch1)
    var c = client.Client.start_with(a, try rfc_shares(), ch1[0..])
    defer c.deinit(a)
    const ch2 = try support.unhex(a, CH2)
    defer a.free(ch2)
    c.replay_retry(a, ch2[0..])
    try give(a, &c, REC_HRR, false)
    var got: anyerror = error.None
    give(a, &c, sh, false) catch |e| {
        got = e
    }
    t.check(io, got == error.IllegalParameter, name)
    if (got != error.IllegalParameter) {
        io.print("  got ", @errorName(got))
    }
}

// The client's outbox is the hex want (taken out of it).
fn sent(io: Io, a: Allocator, inout t: support.Tally, inout c: client.Client, want: str, what: str, name: str) !void {
    const out = c.take_outbox()
    defer a.free(out)
    t.check_of(io, support.same(a, out[0..], want), what, name)
}

// The hex records to the client, whole or a byte at a time.
fn give(a: Allocator, inout c: client.Client, rec: str, bytewise: bool) !void {
    const bytes = try support.unhex(a, rec)
    defer a.free(bytes)
    if (!bytewise) {
        try c.feed(a, bytes[0..])
        return
    }
    var i = 0
    while (i < @len(bytes)) {
        try c.feed(a, bytes[i..i + 1])
        i = i + 1
    }
}

