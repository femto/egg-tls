// sha256: SHA-256 (FIPS 180-4), for TLS 1.3 transcripts, HMAC and HKDF.
//
//     var h = Sha256.init()
//     h.update("ab")
//     h.update("c")
//     const d = h.final()    // [32]u8: ba7816bf...
//
// A Sha256 is a plain value: copying one copies the hash so far, so the
// hash of a prefix can be taken and the original kept going.

const Sha256 = struct {
    h: [8]u32
    buf: [64]u8
    fill: i64
    total: u64

    fn init() Sha256 {
        const iv = [8]u32{
            0x6a09_e667, 0xbb67_ae85, 0x3c6e_f372, 0xa54f_f53a,
            0x510e_527f, 0x9b05_688c, 0x1f83_d9ab, 0x5be0_cd19,
        }
        return Sha256{ .h = iv, .buf = @splat(0), .fill = 0, .total = 0 }
    }

    fn digest_len() i64 {
        return 32
    }

    fn block_len() i64 {
        return 64
    }

    fn update(inout self: Sha256, data: []u8) void {
        var i = 0
        const n = @len(data)
        while (i < n) {
            if (self.fill == 0 and n - i >= 64) {
                compress(&self.h, data[i..i + 64])
                i = i + 64
            } else {
                self.buf[self.fill] = data[i]
                self.fill = self.fill + 1
                i = i + 1
                if (self.fill == 64) {
                    compress(&self.h, self.buf[0..])
                    self.fill = 0
                }
            }
        }
        self.total = self.total + @as(u64, n)
    }

    // The digest of everything given to update; self is unchanged.
    fn final(self: Sha256) [32]u8 {
        // A 1 bit, zeros to 56 bytes past a multiple of 64, and the
        // length in bits as 8 big-endian bytes.
        var s = self
        defer @secureZero(&s)
        const bits = self.total << 3
        var pad: [72]u8 = @splat(0)
        pad[0] = 0x80
        var n = 56 - self.fill
        if (n <= 0) {
            n = n + 64
        }
        var i = 0
        while (i < 8) {
            pad[n + i] = @as(u8, (bits >> (56 - 8 * i)) & 0xFF)
            i = i + 1
        }
        s.update(pad[0..n + 8])
        var out: [32]u8 = @splat(0)
        i = 0
        while (i < 8) {
            out[4 * i] = @as(u8, s.h[i] >> 24)
            out[4 * i + 1] = @as(u8, (s.h[i] >> 16) & 0xFF)
            out[4 * i + 2] = @as(u8, (s.h[i] >> 8) & 0xFF)
            out[4 * i + 3] = @as(u8, s.h[i] & 0xFF)
            i = i + 1
        }
        return out
    }
}

// SHA-256 of data, at once.
fn sum(data: []u8) [32]u8 {
    var h = Sha256.init()
    h.update(data)
    return h.final()
}

fn rotr(x: u32, n: i64) u32 {
    return (x >> n) | (x << (32 - n))
}

// One 64-byte block into the state h.
fn compress(inout h: [8]u32, block: []u8) void {
    const k = [64]u32{
        0x428a_2f98, 0x7137_4491, 0xb5c0_fbcf, 0xe9b5_dba5,
        0x3956_c25b, 0x59f1_11f1, 0x923f_82a4, 0xab1c_5ed5,
        0xd807_aa98, 0x1283_5b01, 0x2431_85be, 0x550c_7dc3,
        0x72be_5d74, 0x80de_b1fe, 0x9bdc_06a7, 0xc19b_f174,
        0xe49b_69c1, 0xefbe_4786, 0x0fc1_9dc6, 0x240c_a1cc,
        0x2de9_2c6f, 0x4a74_84aa, 0x5cb0_a9dc, 0x76f9_88da,
        0x983e_5152, 0xa831_c66d, 0xb003_27c8, 0xbf59_7fc7,
        0xc6e0_0bf3, 0xd5a7_9147, 0x06ca_6351, 0x1429_2967,
        0x27b7_0a85, 0x2e1b_2138, 0x4d2c_6dfc, 0x5338_0d13,
        0x650a_7354, 0x766a_0abb, 0x81c2_c92e, 0x9272_2c85,
        0xa2bf_e8a1, 0xa81a_664b, 0xc24b_8b70, 0xc76c_51a3,
        0xd192_e819, 0xd699_0624, 0xf40e_3585, 0x106a_a070,
        0x19a4_c116, 0x1e37_6c08, 0x2748_774c, 0x34b0_bcb5,
        0x391c_0cb3, 0x4ed8_aa4a, 0x5b9c_ca4f, 0x682e_6ff3,
        0x748f_82ee, 0x78a5_636f, 0x84c8_7814, 0x8cc7_0208,
        0x90be_fffa, 0xa450_6ceb, 0xbef9_a3f7, 0xc671_78f2,
    }
    var w: [64]u32 = @splat(0)
    var i = 0
    while (i < 16) {
        w[i] = @as(u32, block[4 * i]) << 24 | @as(u32, block[4 * i + 1]) << 16 | @as(u32, block[4 * i + 2]) << 8 | @as(u32, block[4 * i + 3])
        i = i + 1
    }
    while (i < 64) {
        const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3)
        const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10)
        w[i] = w[i - 16] +% s0 +% w[i - 7] +% s1
        i = i + 1
    }
    var a = h[0]
    var b = h[1]
    var c = h[2]
    var d = h[3]
    var e = h[4]
    var f = h[5]
    var g = h[6]
    var hh = h[7]
    i = 0
    while (i < 64) {
        const big_s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
        const ch = (e & f) ^ (~e & g)
        const t1 = hh +% big_s1 +% ch +% k[i] +% w[i]
        const big_s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
        const maj = (a & b) ^ (a & c) ^ (b & c)
        const t2 = big_s0 +% maj
        hh = g
        g = f
        f = e
        e = d +% t1
        d = c
        c = b
        b = a
        a = t1 +% t2
        i = i + 1
    }
    h[0] = h[0] +% a
    h[1] = h[1] +% b
    h[2] = h[2] +% c
    h[3] = h[3] +% d
    h[4] = h[4] +% e
    h[5] = h[5] +% f
    h[6] = h[6] +% g
    h[7] = h[7] +% hh
}
