// sha512: SHA-512 and SHA-384 (FIPS 180-4). SHA-384 is SHA-512 from other
// initial values, cut to 48 bytes; TLS 1.3 uses it with AES-256-GCM.
//
//     var h = Sha384.init()
//     h.update("abc")
//     const d = h.final()    // [48]u8: cb00753f...
//
// Both are plain values, copied to keep the hash so far, like Sha256.

const Sha512 = struct {
    h: [8]u64
    buf: [128]u8
    fill: i64
    total: u64

    fn init() Sha512 {
        const iv = [8]u64{
            0x6a09_e667_f3bc_c908, 0xbb67_ae85_84ca_a73b, 0x3c6e_f372_fe94_f82b, 0xa54f_f53a_5f1d_36f1,
            0x510e_527f_ade6_82d1, 0x9b05_688c_2b3e_6c1f, 0x1f83_d9ab_fb41_bd6b, 0x5be0_cd19_137e_2179,
        }
        return Sha512.from(iv)
    }

    fn from(iv: [8]u64) Sha512 {
        return Sha512{ .h = iv, .buf = @splat(0), .fill = 0, .total = 0 }
    }

    fn digest_len() i64 {
        return 64
    }

    fn block_len() i64 {
        return 128
    }

    fn update(inout self: Sha512, data: []u8) void {
        var i = 0
        const n = @len(data)
        while (i < n) {
            if (self.fill == 0 and n - i >= 128) {
                compress(&self.h, data[i..i + 128])
                i = i + 128
            } else {
                self.buf[self.fill] = data[i]
                self.fill = self.fill + 1
                i = i + 1
                if (self.fill == 128) {
                    compress(&self.h, self.buf[0..])
                    self.fill = 0
                }
            }
        }
        self.total = self.total + @as(u64, n)
    }

    fn final(self: Sha512) [64]u8 {
        var s = self.padded()
        defer @secureZero(&s)
        var out: [64]u8 = @splat(0)
        put(&out[0..], s.h)
        return out
    }

    // A 1 bit, zeros to 112 bytes past a multiple of 128, and the length
    // in bits as 16 big-endian bytes: total counts bytes, so the top
    // bits of the length are total >> 61.
    // The caller zeros what this returns.
    fn padded(self: Sha512) Sha512 {
        var s = self
        const bits = self.total << 3
        var pad: [144]u8 = @splat(0)
        pad[0] = 0x80
        var n = 112 - self.fill
        if (n <= 0) {
            n = n + 128
        }
        pad[n + 7] = @as(u8, self.total >> 61)
        var i = 0
        while (i < 8) {
            pad[n + 8 + i] = @as(u8, (bits >> (56 - 8 * i)) & 0xFF)
            i = i + 1
        }
        s.update(pad[0..n + 16])
        return s
    }
}

const Sha384 = struct {
    inner: Sha512

    fn init() Sha384 {
        const iv = [8]u64{
            0xcbbb_9d5d_c105_9ed8, 0x629a_292a_367c_d507, 0x9159_015a_3070_dd17, 0x152f_ecd8_f70e_5939,
            0x6733_2667_ffc0_0b31, 0x8eb4_4a87_6858_1511, 0xdb0c_2e0d_64f9_8fa7, 0x47b5_481d_befa_4fa4,
        }
        return Sha384{ .inner = Sha512.from(iv) }
    }

    fn digest_len() i64 {
        return 48
    }

    fn block_len() i64 {
        return 128
    }

    fn update(inout self: Sha384, data: []u8) void {
        self.inner.update(data)
    }

    fn final(self: Sha384) [48]u8 {
        var s = self.inner.padded()
        defer @secureZero(&s)
        var out: [48]u8 = @splat(0)
        put(&out[0..], s.h)
        return out
    }
}

// SHA-512 of data, at once.
fn sum512(data: []u8) [64]u8 {
    var h = Sha512.init()
    h.update(data)
    return h.final()
}

// SHA-384 of data, at once.
fn sum384(data: []u8) [48]u8 {
    var h = Sha384.init()
    h.update(data)
    return h.final()
}

// The words of h as big-endian bytes, as many as out holds.
fn put(inout out: []u8, h: [8]u64) void {
    var i = 0
    while (i < @len(out)) {
        out[i] = @as(u8, (h[i / 8] >> (56 - 8 * (i % 8))) & 0xFF)
        i = i + 1
    }
}

fn rotr(x: u64, n: i64) u64 {
    return (x >> n) | (x << (64 - n))
}

// One 128-byte block into the state h.
fn compress(inout h: [8]u64, block: []u8) void {
    const k = [80]u64{
        0x428a_2f98_d728_ae22, 0x7137_4491_23ef_65cd, 0xb5c0_fbcf_ec4d_3b2f, 0xe9b5_dba5_8189_dbbc,
        0x3956_c25b_f348_b538, 0x59f1_11f1_b605_d019, 0x923f_82a4_af19_4f9b, 0xab1c_5ed5_da6d_8118,
        0xd807_aa98_a303_0242, 0x1283_5b01_4570_6fbe, 0x2431_85be_4ee4_b28c, 0x550c_7dc3_d5ff_b4e2,
        0x72be_5d74_f27b_896f, 0x80de_b1fe_3b16_96b1, 0x9bdc_06a7_25c7_1235, 0xc19b_f174_cf69_2694,
        0xe49b_69c1_9ef1_4ad2, 0xefbe_4786_384f_25e3, 0x0fc1_9dc6_8b8c_d5b5, 0x240c_a1cc_77ac_9c65,
        0x2de9_2c6f_592b_0275, 0x4a74_84aa_6ea6_e483, 0x5cb0_a9dc_bd41_fbd4, 0x76f9_88da_8311_53b5,
        0x983e_5152_ee66_dfab, 0xa831_c66d_2db4_3210, 0xb003_27c8_98fb_213f, 0xbf59_7fc7_beef_0ee4,
        0xc6e0_0bf3_3da8_8fc2, 0xd5a7_9147_930a_a725, 0x06ca_6351_e003_826f, 0x1429_2967_0a0e_6e70,
        0x27b7_0a85_46d2_2ffc, 0x2e1b_2138_5c26_c926, 0x4d2c_6dfc_5ac4_2aed, 0x5338_0d13_9d95_b3df,
        0x650a_7354_8baf_63de, 0x766a_0abb_3c77_b2a8, 0x81c2_c92e_47ed_aee6, 0x9272_2c85_1482_353b,
        0xa2bf_e8a1_4cf1_0364, 0xa81a_664b_bc42_3001, 0xc24b_8b70_d0f8_9791, 0xc76c_51a3_0654_be30,
        0xd192_e819_d6ef_5218, 0xd699_0624_5565_a910, 0xf40e_3585_5771_202a, 0x106a_a070_32bb_d1b8,
        0x19a4_c116_b8d2_d0c8, 0x1e37_6c08_5141_ab53, 0x2748_774c_df8e_eb99, 0x34b0_bcb5_e19b_48a8,
        0x391c_0cb3_c5c9_5a63, 0x4ed8_aa4a_e341_8acb, 0x5b9c_ca4f_7763_e373, 0x682e_6ff3_d6b2_b8a3,
        0x748f_82ee_5def_b2fc, 0x78a5_636f_4317_2f60, 0x84c8_7814_a1f0_ab72, 0x8cc7_0208_1a64_39ec,
        0x90be_fffa_2363_1e28, 0xa450_6ceb_de82_bde9, 0xbef9_a3f7_b2c6_7915, 0xc671_78f2_e372_532b,
        0xca27_3ece_ea26_619c, 0xd186_b8c7_21c0_c207, 0xeada_7dd6_cde0_eb1e, 0xf57d_4f7f_ee6e_d178,
        0x06f0_67aa_7217_6fba, 0x0a63_7dc5_a2c8_98a6, 0x113f_9804_bef9_0dae, 0x1b71_0b35_131c_471b,
        0x28db_77f5_2304_7d84, 0x32ca_ab7b_40c7_2493, 0x3c9e_be0a_15c9_bebc, 0x431d_67c4_9c10_0d4c,
        0x4cc5_d4be_cb3e_42b6, 0x597f_299c_fc65_7e2a, 0x5fcb_6fab_3ad6_faec, 0x6c44_198c_4a47_5817,
    }
    var w: [80]u64 = @splat(0)
    var i = 0
    while (i < 16) {
        var x: u64 = 0
        var j = 0
        while (j < 8) {
            x = x << 8 | @as(u64, block[8 * i + j])
            j = j + 1
        }
        w[i] = x
        i = i + 1
    }
    while (i < 80) {
        const s0 = rotr(w[i - 15], 1) ^ rotr(w[i - 15], 8) ^ (w[i - 15] >> 7)
        const s1 = rotr(w[i - 2], 19) ^ rotr(w[i - 2], 61) ^ (w[i - 2] >> 6)
        w[i] = w[i - 16] +% s0 +% w[i - 7] +% s1
        i = i + 1
    }
    var a = h[0]
    var b = h[1]
    var c = h[2]
    var d = h[3]
    var e = h[4]
    var f = h[5]
    var g = h[6]
    var hh = h[7]
    i = 0
    while (i < 80) {
        const big_s1 = rotr(e, 14) ^ rotr(e, 18) ^ rotr(e, 41)
        const ch = (e & f) ^ (~e & g)
        const t1 = hh +% big_s1 +% ch +% k[i] +% w[i]
        const big_s0 = rotr(a, 28) ^ rotr(a, 34) ^ rotr(a, 39)
        const maj = (a & b) ^ (a & c) ^ (b & c)
        const t2 = big_s0 +% maj
        hh = g
        g = f
        f = e
        e = d +% t1
        d = c
        c = b
        b = a
        a = t1 +% t2
        i = i + 1
    }
    h[0] = h[0] +% a
    h[1] = h[1] +% b
    h[2] = h[2] +% c
    h[3] = h[3] +% d
    h[4] = h[4] +% e
    h[5] = h[5] +% f
    h[6] = h[6] +% g
    h[7] = h[7] +% hh
}
