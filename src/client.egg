// client: the TLS 1.3 client (RFC 8446) as a state machine over bytes,
// with no socket: what arrives is given to feed, and what is to be sent
// collects in an outbox. tls.client runs one over a TcpConn; tests run
// one over recorded handshakes.
//
//     var c = try Client.start(a, shares, random, "example.com")
//     defer c.deinit(a)
//     c.trust(a, roots, now)         // check the server's certificates
//     // send c.take_outbox(a), the ClientHello, then until c.connected():
//     try c.feed(a, received)        // and send c.take_outbox(a) again
//     try c.send(a, "GET / HTTP/1.1\r\n...")
//
// It offers the three TLS 1.3 cipher suites (ChaCha20-Poly1305 first),
// the groups X25519, P-256 and P-384, and key shares for the first two,
// so that a server that takes only P-256 needs no HelloRetryRequest. A
// HelloRetryRequest for P-384, or with a cookie, is answered with a
// second ClientHello (RFC 8446, 4.1.4); a second one, or one that would
// change nothing, fails. It takes no PSK or early data.
//
// After trust, it checks the server: the certificate chain against the
// roots, for the host, at now (tls/x509), and the CertificateVerify
// signature by the leaf's key over the handshake so far (ECDSA on P-256
// or P-384, RSA-PSS with SHA-256, -384 or -512). A failure is x509's
// error (UnknownIssuer, HostMismatch, ...), or BadSignature, or
// IllegalParameter for a signature scheme that does not fit the key.
// **Without trust it checks neither**, and anyone on the path can be the
// server: tls.client_unverified, for tests against a server of one's
// own (and RFC 8448's recorded handshake, whose key is 1024-bit RSA).
//
// Failures: error.DecodeError (a message that does
// not parse), error.UnexpectedMessage (one out of order), error.IllegalParameter
// (a value the client did not offer), error.ProtocolVersion (a server
// without TLS 1.3), error.AuthFailed (a record that does not decrypt),
// error.BadFinished, error.RecordOverflow, error.AlertReceived (the server
// sent an alert other than close_notify, or close_notify before the
// handshake finished; alert() is its description).
uses alloc

const ks = @import("key_schedule.egg")
const record = @import("record.egg")
const x25519 = @import("x25519.egg")
const ec = @import("ec.egg")
const ecdsa = @import("ecdsa.egg")
const rsa = @import("rsa.egg")
const sha256 = @import("sha256.egg")
const sha512 = @import("sha512.egg")
const x509 = @import("x509.egg")

// The secrets of the key shares a client may send: X25519 and P-256 in
// its first ClientHello, P-384 if a HelloRetryRequest asks for it. Each
// fresh and random; the P-256 and P-384 ones below their group's order.
const Shares = struct {
    x25519: [32]u8
    p256: [32]u8
    p384: [48]u8
}

// The groups, as bits of a set: which shares a ClientHello carries.
const X25519: i64 = 1
const P256: i64 = 2
const P384: i64 = 4

fn group_bit(code: i64) i64 {
    if (code == 0x001D) {
        return X25519
    }
    if (code == 0x0017) {
        return P256
    }
    if (code == 0x0018) {
        return P384
    }
    return 0
}

const State = enum { server_hello, encrypted_extensions, certificate, certificate_verify, finished, connected, closed }

// Content types of records.
const CHANGE_CIPHER_SPEC: u8 = 20
const ALERT: u8 = 21
const HANDSHAKE: u8 = 22
const APPLICATION_DATA: u8 = 23

// The longest plaintext a record holds, and the longest encrypted body.
const MAX_PLAIN: i64 = 16384
const MAX_CIPHER: i64 = 16384 + 256
// The longest handshake message taken (a certificate chain, mostly).
const MAX_HANDSHAKE: i64 = 262144
// Records sent under one key before the next (RFC 8446, 5.5: AES-GCM is
// good for 2^24.5 full records per key).
const REKEY_AFTER: u64 = 16777216

// The secrets a client holds, each as long as the suite's hash (at most
// 48 bytes). The handshake's are zeroed once the handshake is over.
const Secrets = struct {
    client_hs: [48]u8
    server_hs: [48]u8
    master: [48]u8
    client_ap: [48]u8
    server_ap: [48]u8
}

const Client = owned struct {
    state: State
    suite: record.Suite
    // Our key share secrets, zeroed once the shared secret is computed.
    shares: Shares
    // The groups whose shares the last ClientHello carried.
    offered: i64
    // For a second ClientHello: its random, and what the
    // HelloRetryRequest asked for (a suite, a group or 0, a cookie).
    random: [32]u8
    retried: bool
    retry_suite: record.Suite
    retry_group: i64
    cookie: Buf(u8)
    // A second ClientHello to send as it is, for tests that replay a
    // recorded handshake.
    retry_hello: Buf(u8)
    transcript: ks.Transcript
    keys: Secrets
    read: record.Protection
    write: record.Protection
    // The server asked for a client certificate: we send an empty one.
    cert_requested: bool
    // The handshake finished: there are application keys to send with.
    established: bool
    // We sent close_notify: nothing more may be sent.
    sent_close: bool
    cert_context: Buf(u8)
    alert_desc: i64
    // Bytes received that do not yet make a whole record.
    inbox: Buf(u8)
    // Handshake bytes that do not yet make a whole message.
    hs: Buf(u8)
    // Records to send.
    outbox: Buf(u8)
    // Application data received, not yet taken.
    plain: Buf(u8)
    // What checks the server: on after trust.
    verify: bool
    roots: x509.CertList
    host: Buf(u8)
    now: i64
    // The server's certificates, leaf first.
    chain: x509.CertList

    // A client whose ClientHello, for host, is in the outbox. secret is a
    // fresh X25519 secret, p256_secret a fresh P-256 one (from 1 to the
    // order less one: error.BadScalar otherwise), and random 32 fresh
    // random bytes; host is a DNS
    // name, sent as server_name (an IP address is not: RFC 6066), or empty.
    fn start(a: Allocator, shares: Shares, random: [32]u8, host: []u8) !Client {
        var hello: Buf(u8) = .empty
        defer a.free(hello)
        try client_hello(a, &hello, random, host, shares, X25519 | P256, "")
        var c = Client.start_with(a, shares, hello[0..])
        c.random = random
        a.append_str(&c.host, host)
        return c
    }

    // A client that sends hello, a whole ClientHello message whose key
    // shares are the public keys of shares: for tests that replay a
    // recorded handshake.
    fn start_with(a: Allocator, shares: Shares, hello: []u8) Client {
        var c = Client{
            .state = .server_hello,
            .suite = .aes_128_gcm_sha256,
            .shares = shares,
            .offered = shares_in(hello),
            .random = @splat(0),
            .retried = false,
            .retry_suite = .aes_128_gcm_sha256,
            .retry_group = 0,
            .cookie = .empty,
            .retry_hello = .empty,
            .transcript = ks.Transcript.init(),
            .keys = Secrets{ .client_hs = @splat(0), .server_hs = @splat(0), .master = @splat(0), .client_ap = @splat(0), .server_ap = @splat(0) },
            .read = record.Protection.none(),
            .write = record.Protection.none(),
            .cert_requested = false,
            .established = false,
            .sent_close = false,
            .cert_context = .empty,
            .alert_desc = -1,
            .inbox = .empty,
            .hs = .empty,
            .outbox = .empty,
            .plain = .empty,
            .verify = false,
            .roots = x509.CertList.empty(),
            .host = .empty,
            .now = 0,
            .chain = x509.CertList.empty(),
        }
        c.transcript.update(hello)
        // A plaintext record; its version is 0x0301 for old middleboxes.
        a.push(&c.outbox, HANDSHAKE)
        put16(a, &c.outbox, 0x0301)
        put16(a, &c.outbox, @len(hello))
        a.append_str(&c.outbox, hello)
        return c
    }

    // The second ClientHello to send if a HelloRetryRequest comes, as it
    // is: for tests that replay a recorded handshake.
    fn replay_retry(inout self: Client, a: Allocator, hello: []u8) void {
        a.append_str(&self.retry_hello, hello)
    }

    // From now on the server must prove it is host, with a chain to one of
    // roots valid at now (seconds since 1970). Call it right after start.
    fn trust(inout self: Client, a: Allocator, sink roots: x509.CertList, now: i64) void {
        a.free(@replace(&self.roots, roots))
        self.now = now
        self.verify = true
    }

    fn deinit(sink self: Client, a: Allocator) void {
        var c = self
        @secureZero(&c.shares)
        a.free(c.cookie)
        a.free(c.retry_hello)
        @secureZero(&c.keys)
        @secureZero(&c.read)
        @secureZero(&c.write)
        @secureZero(&c.transcript)
        a.free(c.cert_context)
        a.free(c.inbox)
        a.free(c.hs)
        a.free(c.outbox)
        @secureZero(&c.plain[0..])
        a.free(c.plain)
        a.free(c.roots)
        a.free(c.host)
        a.free(c.chain)
        @forget(c)
    }

    fn connected(self: Client) bool {
        return self.state == .connected
    }

    // The handshake finished, even if the server has closed since (its
    // Finished and close_notify may arrive together).
    fn handshake_done(self: Client) bool {
        return self.established
    }

    // The server has sent close_notify: nothing more will arrive.
    fn closed(self: Client) bool {
        return self.state == .closed
    }

    fn cipher_suite(self: Client) record.Suite {
        return self.suite
    }

    // The description of the alert that ended the connection, or -1.
    fn alert(self: Client) i64 {
        return self.alert_desc
    }

    // What is to be sent, taken out of the outbox.
    fn take_outbox(inout self: Client) Buf(u8) {
        return @take(&self.outbox)
    }

    fn has_plain(self: Client) bool {
        return @len(self.plain) > 0
    }

    // Up to n bytes of application data received, in place of what buf
    // held; how many.
    fn read_plain(inout self: Client, a: Allocator, inout buf: Buf(u8), n: i64) i64 {
        if (n >= @len(self.plain)) {
            a.free(@replace(&buf, @take(&self.plain)))
            return @len(buf)
        }
        a.resize(&buf, n, 0)
        var i = 0
        while (i < n) {
            buf[i] = self.plain[i]
            i = i + 1
        }
        drop_front(a, &self.plain, n)
        return n
    }

    // Takes in bytes received, which may hold any part of any number of
    // records: whole records are handled, the rest kept for later.
    fn feed(inout self: Client, a: Allocator, data: []u8) !void {
        a.append_str(&self.inbox, data)
        var at = 0
        var rec: Buf(u8) = .empty
        defer a.free(rec)
        while (self.state != .closed and @len(self.inbox) - at >= 5) {
            const kind = self.inbox[at]
            const n = be16(self.inbox[0..], at + 3)
            if (n > MAX_CIPHER) {
                return error.RecordOverflow
            }
            if (@len(self.inbox) - at - 5 < n) {
                break
            }
            const header = [5]u8{ self.inbox[at], self.inbox[at + 1], self.inbox[at + 2], self.inbox[at + 3], self.inbox[at + 4] }
            a.resize(&rec, 0, 0)
            a.append_str(&rec, self.inbox[at + 5..at + 5 + n])
            at = at + 5 + n
            try self.record_in(a, kind, header, &rec)
        }
        drop_front(a, &self.inbox, at)
    }

    // Application data, sent in records of at most 16 KiB.
    fn send(inout self: Client, a: Allocator, data: []u8) !void {
        if (self.sent_close) {
            return error.Closed
        }
        if (self.state != .connected) {
            return error.NotConnected
        }
        var at = 0
        while (at < @len(data)) {
            const end = if (@len(data) - at > MAX_PLAIN) at + MAX_PLAIN else @len(data)
            if (self.write.seq >= REKEY_AFTER) {
                self.next_write_key(a)
            }
            self.seal_record(a, APPLICATION_DATA, data[at..end])
            at = end
        }
    }

    // A close_notify alert, after which nothing more is sent (send is
    // error.Closed, and a second close_notify sends nothing).
    fn close_notify(inout self: Client, a: Allocator) void {
        if (self.established and !self.sent_close) {
            const body = [2]u8{ 1, 0 }
            self.seal_record(a, ALERT, body[0..])
            self.sent_close = true
        }
    }

    // One record: its type, header, and body (decrypted here in place).
    fn record_in(inout self: Client, a: Allocator, kind: u8, header: [5]u8, inout rec: Buf(u8)) !void {
        // A handshake message split over records has nothing between
        // its parts (RFC 8446, 5.1).
        if (@len(self.hs) != 0 and kind != HANDSHAKE and kind != APPLICATION_DATA) {
            return error.UnexpectedMessage
        }
        if (self.state == .server_hello) {
            if (kind == CHANGE_CIPHER_SPEC and self.retried and @len(rec) == 1 and rec[0] == 1) {
                // Sent for middleboxes after a HelloRetryRequest (D.4).
                return
            }
            if (kind == ALERT) {
                // A plaintext alert: the server refused the ClientHello.
                // After the ServerHello, alerts are encrypted.
                try self.alert_in(rec[0..])
                return
            }
            if (kind != HANDSHAKE) {
                return error.UnexpectedMessage
            }
            try self.handshake_in(a, rec[0..])
            return
        }
        if (kind == CHANGE_CIPHER_SPEC) {
            // Sent for middleboxes during the handshake (RFC 8446, D.4).
            if (self.state == .connected or @len(rec) != 1 or rec[0] != 1) {
                return error.UnexpectedMessage
            }
            return
        }
        if (kind != APPLICATION_DATA) {
            return error.UnexpectedMessage
        }
        try self.read.open(header[0..], &rec[0..])
        // The inner plaintext: the content, its type, then zeros.
        var end = @len(rec) - 16
        while (end > 0 and rec[end - 1] == 0) {
            end = end - 1
        }
        if (end == 0) {
            return error.UnexpectedMessage
        }
        const inner = rec[end - 1]
        if (end - 1 > MAX_PLAIN) {
            return error.RecordOverflow
        }
        if (inner != HANDSHAKE and @len(self.hs) != 0) {
            return error.UnexpectedMessage
        }
        if (inner == HANDSHAKE) {
            try self.handshake_in(a, rec[0..end - 1])
        } else if (inner == ALERT) {
            try self.alert_in(rec[0..end - 1])
        } else if (inner == APPLICATION_DATA and self.state == .connected) {
            a.append_str(&self.plain, rec[0..end - 1])
        } else {
            return error.UnexpectedMessage
        }
        @secureZero(&rec[0..])
    }

    fn alert_in(inout self: Client, body: []u8) !void {
        if (@len(body) != 2) {
            return error.DecodeError
        }
        self.alert_desc = @as(i64, body[1])
        const was_connected = self.state == .connected
        self.state = .closed
        // close_notify ends a connection; before one is made, it is a
        // failure like any other alert.
        if (body[1] == 0 and was_connected) {
            return
        }
        return error.AlertReceived
    }

    // Handshake bytes: each whole message is handled in turn.
    fn handshake_in(inout self: Client, a: Allocator, data: []u8) !void {
        a.append_str(&self.hs, data)
        var msg: Buf(u8) = .empty
        defer a.free(msg)
        while (@len(self.hs) >= 4) {
            const n = be24(self.hs[0..], 1)
            if (n > MAX_HANDSHAKE) {
                return error.DecodeError
            }
            if (@len(self.hs) < 4 + n) {
                break
            }
            a.resize(&msg, 0, 0)
            a.append_str(&msg, self.hs[0..4 + n])
            drop_front(a, &self.hs, 4 + n)
            try self.message(a, msg[0..])
        }
    }

    // One handshake message, whole, with its 4-byte header.
    fn message(inout self: Client, a: Allocator, msg: []u8) !void {
        const kind = msg[0]
        const body = msg[4..]
        switch (self.state) {
            .server_hello => {
                if (kind != 2) {
                    return error.UnexpectedMessage
                }
                if (@len(body) >= 34 and is_retry(body)) {
                    try self.hello_retry(a, msg)
                    // It must end its record, like a ServerHello.
                    if (@len(self.hs) != 0) {
                        return error.UnexpectedMessage
                    }
                    return
                }
                try self.server_hello(body)
                self.transcript.update(msg)
                self.handshake_keys()
                // The ServerHello must end its record: what follows is
                // encrypted.
                if (@len(self.hs) != 0) {
                    return error.UnexpectedMessage
                }
                self.state = .encrypted_extensions
            }
            .encrypted_extensions => {
                if (kind != 8) {
                    return error.UnexpectedMessage
                }
                try check_extensions(body, 0)
                self.transcript.update(msg)
                self.state = .certificate
            }
            .certificate => {
                if (kind == 13 and !self.cert_requested) {
                    try self.certificate_request(a, body)
                    self.transcript.update(msg)
                } else if (kind == 11) {
                    try check_certificate(body)
                    if (self.verify) {
                        try self.certificates(a, body)
                        try x509.verify(self.chain, self.roots, self.host[0..], self.now)
                    }
                    self.transcript.update(msg)
                    self.state = .certificate_verify
                } else {
                    return error.UnexpectedMessage
                }
            }
            .certificate_verify => {
                if (kind != 15) {
                    return error.UnexpectedMessage
                }
                // { u16 scheme; u16 length; signature }.
                if (@len(body) < 4 or be16(body, 2) != @len(body) - 4) {
                    return error.DecodeError
                }
                if (self.verify) {
                    try self.certificate_verify(be16(body, 0), body[4..])
                }
                self.transcript.update(msg)
                self.state = .finished
            }
            .finished => {
                if (kind != 20) {
                    return error.UnexpectedMessage
                }
                try self.server_finished(a, msg)
                if (@len(self.hs) != 0) {
                    return error.UnexpectedMessage
                }
            }
            .connected => {
                if (kind == 4) {
                    // NewSessionTicket: no resumption yet.
                    return
                }
                if (kind == 24) {
                    try self.key_update(a, body)
                    return
                }
                return error.UnexpectedMessage
            }
            .closed => {
                return error.UnexpectedMessage
            }
        }
    }

    // The certificates of a Certificate message (check_certificate has
    // checked its framing) into chain, leaf first.
    fn certificates(inout self: Client, a: Allocator, body: []u8) !void {
        var at = 4
        while (at < @len(body)) {
            const n = be24(body, at)
            try self.chain.add(a, body[at + 3..at + 3 + n])
            at = at + 3 + n
            at = at + 2 + be16(body, at)
        }
    }

    // The server's CertificateVerify (RFC 8446, 4.4.3): signature by the
    // leaf's key, with scheme, over 64 spaces, the context string, a 0 and
    // the transcript hash up to the Certificate.
    fn certificate_verify(self: Client, scheme: i64, signature: []u8) !void {
        const h = record.suite_hash(self.suite)
        const hl = ks.hash_len(h)
        var content: [146]u8 = @splat(0x20)
        const context = "TLS 1.3, server CertificateVerify"
        var i = 0
        while (i < @len(context)) {
            content[64 + i] = context[i]
            i = i + 1
        }
        content[64 + @len(context)] = 0
        const at = 64 + @len(context) + 1
        self.transcript.digest(h, &content[at..at + hl])
        const message = content[0..at + hl]
        const leaf = self.chain.certs[0]
        const key = self.chain.bytes[leaf.key_at..leaf.key_end]
        if (scheme == 0x0403 and leaf.key_kind == .p256) {
            const d = sha256.sum(message)
            try ecdsa.verify_der(ec.p256(), key, d[0..], signature)
        } else if (scheme == 0x0503 and leaf.key_kind == .p384) {
            const d = sha512.sum384(message)
            try ecdsa.verify_der(ec.p384(), key, d[0..], signature)
        } else if ((scheme == 0x0804 or scheme == 0x0805 or scheme == 0x0806) and leaf.key_kind == .rsa) {
            // RSA-PSS with MGF1 over the same hash, salt as long as it.
            const k = try rsa.public_key(key, self.chain.bytes[leaf.exp_at..leaf.exp_end])
            if (scheme == 0x0804) {
                const d = sha256.sum(message)
                try rsa.verify_pss(k, .sha256, d[0..], signature, 32)
            } else if (scheme == 0x0805) {
                const d = sha512.sum384(message)
                try rsa.verify_pss(k, .sha384, d[0..], signature, 48)
            } else {
                const d = sha512.sum512(message)
                try rsa.verify_pss(k, .sha512, d[0..], signature, 64)
            }
        } else {
            // A scheme not offered, or not for this key (PKCS #1 v1.5 is
            // for certificates only in TLS 1.3).
            return error.IllegalParameter
        }
    }

    // A HelloRetryRequest (RFC 8446, 4.1.4), whole: what it asks for, the
    // transcript restarted from the first ClientHello's hash, and a second
    // ClientHello in the outbox.
    fn hello_retry(inout self: Client, a: Allocator, msg: []u8) !void {
        if (self.retried) {
            return error.UnexpectedMessage
        }
        const body = msg[4..]
        if (be16(body, 0) != 0x0303) {
            return error.ProtocolVersion
        }
        if (@len(body) < 35 + 2 + 1 + 2 or body[34] != 0) {
            return error.IllegalParameter
        }
        const suite = record.suite_of(be16(body, 35)) orelse return error.IllegalParameter
        if (body[37] != 0) {
            return error.IllegalParameter
        }
        try check_extensions(body, 38)
        var version_ok = false
        var group = 0
        var at = 40
        while (at < @len(body)) {
            const ext = be16(body, at)
            const n = be16(body, at + 2)
            const data = body[at + 4..at + 4 + n]
            if (ext == 43) {
                if (n != 2 or be16(data, 0) != 0x0304) {
                    return error.IllegalParameter
                }
                version_ok = true
            } else if (ext == 51) {
                // key_share: only the group wanted.
                if (n != 2) {
                    return error.DecodeError
                }
                group = be16(data, 0)
            } else if (ext == 44) {
                // cookie: u16 length, at least one byte, sent back as it is.
                if (n < 3 or be16(data, 0) != n - 2) {
                    return error.DecodeError
                }
                a.append_str(&self.cookie, data[2..])
            } else {
                return error.UnsupportedExtension
            }
            at = at + 4 + n
        }
        if (!version_ok) {
            return error.ProtocolVersion
        }
        // It must change something: a group offered but not shared, or a
        // cookie.
        if (group != 0 and (group_bit(group) == 0 or group_bit(group) & self.offered != 0)) {
            return error.IllegalParameter
        }
        if (group == 0 and @len(self.cookie) == 0) {
            return error.IllegalParameter
        }
        self.retried = true
        self.retry_suite = suite
        self.retry_group = group
        // The transcript: message_hash (254) with the first ClientHello's
        // hash, then this message (4.4.1).
        const h = record.suite_hash(suite)
        const hl = ks.hash_len(h)
        var first: [48]u8 = @splat(0)
        self.transcript.digest(h, &first[0..hl])
        self.transcript = ks.Transcript.init()
        const header = [4]u8{ 254, 0, 0, @as(u8, hl) }
        self.transcript.update(header[0..])
        self.transcript.update(first[0..hl])
        self.transcript.update(msg)
        // The second ClientHello: the first, with the share asked for (or
        // the same shares) and the cookie.
        const which = if (group != 0) group_bit(group) else self.offered
        var hello = @take(&self.retry_hello)
        defer a.free(hello)
        if (@len(hello) == 0) {
            try client_hello(a, &hello, self.random, self.host[0..], self.shares, which, self.cookie[0..])
        }
        self.offered = which
        self.transcript.update(hello[0..])
        a.push(&self.outbox, HANDSHAKE)
        put16(a, &self.outbox, 0x0303)
        put16(a, &self.outbox, @len(hello))
        a.append_str(&self.outbox, hello)
    }

    fn server_hello(inout self: Client, body: []u8) !void {
        // u16 version; random[32]; u8 session id length, id; u16 suite;
        // u8 compression; u16 extensions length, extensions.
        if (@len(body) < 2 + 32 + 1) {
            return error.DecodeError
        }
        if (be16(body, 0) != 0x0303) {
            return error.ProtocolVersion
        }
        // We send an empty session id; the echo must be empty too.
        if (body[34] != 0) {
            return error.IllegalParameter
        }
        if (@len(body) < 35 + 2 + 1 + 2) {
            return error.DecodeError
        }
        const suite = record.suite_of(be16(body, 35)) orelse return error.IllegalParameter
        // After a HelloRetryRequest, the suite it chose.
        if (body[37] != 0 or (self.retried and suite != self.retry_suite)) {
            return error.IllegalParameter
        }
        try check_extensions(body, 38)
        var version_ok = false
        var group = 0
        var peer: [97]u8 = @splat(0)
        var at = 40
        while (at < @len(body)) {
            const ext = be16(body, at)
            const n = be16(body, at + 2)
            const data = body[at + 4..at + 4 + n]
            if (ext == 43) {
                // supported_versions: the one chosen.
                if (n != 2 or be16(data, 0) != 0x0304) {
                    return error.IllegalParameter
                }
                version_ok = true
            } else if (ext == 51) {
                // key_share: u16 group; u16 length; key, for a group whose
                // share was offered. X25519's key is 32 bytes, P-256's an
                // uncompressed point of 65, P-384's of 97.
                if (n < 4 or be16(data, 2) != n - 4) {
                    return error.DecodeError
                }
                group = be16(data, 0)
                if (group_bit(group) & self.offered == 0) {
                    return error.IllegalParameter
                }
                if (!(group == 0x001D and n == 4 + 32) and !(group == 0x0017 and n == 4 + 65) and !(group == 0x0018 and n == 4 + 97)) {
                    return error.IllegalParameter
                }
                var i = 0
                while (i < n - 4) {
                    peer[i] = data[4 + i]
                    i = i + 1
                }
            } else {
                // Nothing else was offered that a ServerHello may answer.
                return error.UnsupportedExtension
            }
            at = at + 4 + n
        }
        if (!version_ok) {
            return error.ProtocolVersion
        }
        if (group == 0) {
            return error.MissingExtension
        }
        // The shared secret: 32 bytes, or 48 for P-384.
        var shared: [48]u8 = @splat(0)
        defer @secureZero(&shared)
        var sl = 32
        if (group == 0x001D) {
            var x: [32]u8 = @splat(0)
            var i = 0
            while (i < 32) {
                x[i] = peer[i]
                i = i + 1
            }
            var out = try x25519.shared(self.shares.x25519, x)
            defer @secureZero(&out)
            i = 0
            while (i < 32) {
                shared[i] = out[i]
                i = i + 1
            }
        } else if (group == 0x0017) {
            try ec.shared(ec.p256(), self.shares.p256[0..], peer[0..65], &shared[0..32])
        } else {
            try ec.shared(ec.p384(), self.shares.p384[0..], peer[0..97], &shared[0..48])
            sl = 48
        }
        @secureZero(&self.shares)
        self.suite = suite
        // The handshake secret goes into master until handshake_keys
        // replaces it with the master secret.
        const h = record.suite_hash(suite)
        const hl = ks.hash_len(h)
        var early: [48]u8 = @splat(0)
        defer @secureZero(&early)
        ks.early_secret(h, &early[0..hl])
        ks.handshake_secret(h, early[0..hl], shared[0..sl], &self.keys.master[0..hl])
    }

    // After the ServerHello is in the transcript: the handshake traffic
    // secrets and keys, and the master secret.
    fn handshake_keys(inout self: Client) void {
        const h = record.suite_hash(self.suite)
        const hl = ks.hash_len(h)
        var th: [48]u8 = @splat(0)
        self.transcript.digest(h, &th[0..hl])
        var hs_secret = self.keys.master
        defer @secureZero(&hs_secret)
        ks.derive_secret(h, hs_secret[0..hl], "c hs traffic", th[0..hl], &self.keys.client_hs[0..hl])
        ks.derive_secret(h, hs_secret[0..hl], "s hs traffic", th[0..hl], &self.keys.server_hs[0..hl])
        ks.master_secret(h, hs_secret[0..hl], &self.keys.master[0..hl])
        self.read = record.Protection.init(self.suite, self.keys.server_hs[0..hl])
        self.write = record.Protection.init(self.suite, self.keys.client_hs[0..hl])
    }

    fn certificate_request(inout self: Client, a: Allocator, body: []u8) !void {
        // u8 context length, context; u16 extensions length, extensions.
        if (@len(body) < 1 or @len(body) < 1 + @as(i64, body[0]) + 2) {
            return error.DecodeError
        }
        const n = @as(i64, body[0])
        try check_extensions(body, 1 + n)
        a.append_str(&self.cert_context, body[1..1 + n])
        self.cert_requested = true
    }

    // The server's Finished, whole: checked, and answered with ours.
    fn server_finished(inout self: Client, a: Allocator, msg: []u8) !void {
        const h = record.suite_hash(self.suite)
        const hl = ks.hash_len(h)
        if (@len(msg) != 4 + hl) {
            return error.DecodeError
        }
        var th: [48]u8 = @splat(0)
        self.transcript.digest(h, &th[0..hl])
        var want: [48]u8 = @splat(0)
        defer @secureZero(&want)
        ks.verify_data(h, self.keys.server_hs[0..hl], th[0..hl], &want[0..hl])
        if (!same(want[0..hl], msg[4..])) {
            return error.BadFinished
        }
        self.transcript.update(msg)
        // The application traffic secrets hash the handshake up to here.
        self.transcript.digest(h, &th[0..hl])
        ks.derive_secret(h, self.keys.master[0..hl], "c ap traffic", th[0..hl], &self.keys.client_ap[0..hl])
        ks.derive_secret(h, self.keys.master[0..hl], "s ap traffic", th[0..hl], &self.keys.server_ap[0..hl])
        self.read = record.Protection.init(self.suite, self.keys.server_ap[0..hl])
        var out: Buf(u8) = .empty
        defer a.free(out)
        if (self.cert_requested) {
            // An empty Certificate: we have none.
            a.push(&out, 11)
            put24(a, &out, 1 + @len(self.cert_context) + 3)
            a.push(&out, @as(u8, @len(self.cert_context)))
            a.append_str(&out, self.cert_context)
            put24(a, &out, 0)
            self.transcript.update(out[0..])
            self.seal_record(a, HANDSHAKE, out[0..])
            a.resize(&out, 0, 0)
        }
        self.transcript.digest(h, &th[0..hl])
        var verify: [48]u8 = @splat(0)
        defer @secureZero(&verify)
        ks.verify_data(h, self.keys.client_hs[0..hl], th[0..hl], &verify[0..hl])
        a.push(&out, 20)
        put24(a, &out, hl)
        a.append_str(&out, verify[0..hl])
        self.transcript.update(out[0..])
        self.seal_record(a, HANDSHAKE, out[0..])
        self.write = record.Protection.init(self.suite, self.keys.client_ap[0..hl])
        @secureZero(&self.keys.client_hs)
        @secureZero(&self.keys.server_hs)
        @secureZero(&self.keys.master)
        self.established = true
        self.state = .connected
    }

    // KeyUpdate: the server's next records use its next traffic secret, and
    // if it asks, ours do too, after a KeyUpdate of our own.
    fn key_update(inout self: Client, a: Allocator, body: []u8) !void {
        if (@len(body) != 1 or body[0] > 1) {
            return error.DecodeError
        }
        // It must end its record: the next record has the new key.
        if (@len(self.hs) != 0) {
            return error.UnexpectedMessage
        }
        const h = record.suite_hash(self.suite)
        const hl = ks.hash_len(h)
        next_secret(h, &self.keys.server_ap[0..hl])
        self.read = record.Protection.init(self.suite, self.keys.server_ap[0..hl])
        if (body[0] == 1 and !self.sent_close) {
            self.next_write_key(a)
        }
    }

    // A KeyUpdate(update_not_requested) under the current key, and the
    // next client traffic secret and key for what follows.
    fn next_write_key(inout self: Client, a: Allocator) void {
        const h = record.suite_hash(self.suite)
        const hl = ks.hash_len(h)
        const msg = [5]u8{ 24, 0, 0, 1, 0 }
        self.seal_record(a, HANDSHAKE, msg[0..])
        next_secret(h, &self.keys.client_ap[0..hl])
        self.write = record.Protection.init(self.suite, self.keys.client_ap[0..hl])
    }

    // An encrypted record of content type kind into the outbox.
    fn seal_record(inout self: Client, a: Allocator, kind: u8, data: []u8) void {
        const start = @len(self.outbox)
        const n = @len(data) + 1 + 16
        const header = [5]u8{ APPLICATION_DATA, 3, 3, @as(u8, n >> 8), @as(u8, n & 0xFF) }
        a.append_str(&self.outbox, header[0..])
        a.append_str(&self.outbox, data)
        a.push(&self.outbox, kind)
        a.resize(&self.outbox, start + 5 + n, 0)
        self.write.seal(header[0..], &self.outbox[start + 5..])
    }
}

// The ClientHello message, with its handshake header, into out.
// The shares are those of which (bits of X25519, P256, P384); a cookie,
// if not empty, is a HelloRetryRequest's, sent back.
fn client_hello(a: Allocator, inout out: Buf(u8), random: [32]u8, host: []u8, shares: Shares, which: i64, cookie: []u8) !void {
    if (@len(host) > 255) {
        return error.HostTooLong
    }
    a.push(&out, 1)
    put24(a, &out, 0)
    put16(a, &out, 0x0303)
    a.append_str(&out, random[0..])
    a.push(&out, 0)
    // Cipher suites, in order of preference.
    put16(a, &out, 6)
    put16(a, &out, record.suite_code(.chacha20_poly1305_sha256))
    put16(a, &out, record.suite_code(.aes_128_gcm_sha256))
    put16(a, &out, record.suite_code(.aes_256_gcm_sha384))
    // Compression: none.
    a.push(&out, 1)
    a.push(&out, 0)
    const ext_at = @len(out)
    put16(a, &out, 0)
    if (@len(host) > 0 and !is_ip(host)) {
        // server_name: a list of one host_name.
        put16(a, &out, 0)
        put16(a, &out, @len(host) + 5)
        put16(a, &out, @len(host) + 3)
        a.push(&out, 0)
        put16(a, &out, @len(host))
        a.append_str(&out, host)
    }
    // supported_groups: X25519, P-256, P-384.
    put16(a, &out, 10)
    put16(a, &out, 8)
    put16(a, &out, 6)
    put16(a, &out, 0x001D)
    put16(a, &out, 0x0017)
    put16(a, &out, 0x0018)
    // signature_algorithms: what step 5 checks. ECDSA P-256 and P-384,
    // RSA-PSS, and RSA PKCS #1 v1.5 (for certificates). Not Ed25519.
    const schemes = [8]i64{ 0x0403, 0x0503, 0x0804, 0x0805, 0x0806, 0x0401, 0x0501, 0x0601 }
    put16(a, &out, 13)
    put16(a, &out, 2 + 2 * 8)
    put16(a, &out, 2 * 8)
    var i = 0
    while (i < 8) {
        put16(a, &out, schemes[i])
        i = i + 1
    }
    // supported_versions: TLS 1.3.
    put16(a, &out, 43)
    put16(a, &out, 3)
    a.push(&out, 2)
    put16(a, &out, 0x0304)
    if (@len(cookie) > 0) {
        put16(a, &out, 44)
        put16(a, &out, @len(cookie) + 2)
        put16(a, &out, @len(cookie))
        a.append_str(&out, cookie)
    }
    // key_share: those of which, in this order.
    var shares_len = 0
    if (which & X25519 != 0) {
        shares_len = shares_len + 4 + 32
    }
    if (which & P256 != 0) {
        shares_len = shares_len + 4 + 65
    }
    if (which & P384 != 0) {
        shares_len = shares_len + 4 + 97
    }
    put16(a, &out, 51)
    put16(a, &out, 2 + shares_len)
    put16(a, &out, shares_len)
    if (which & X25519 != 0) {
        put16(a, &out, 0x001D)
        put16(a, &out, 32)
        const pk = x25519.public_key(shares.x25519)
        a.append_str(&out, pk[0..])
    }
    if (which & P256 != 0) {
        var pk: [65]u8 = @splat(0)
        try ec.public_key(ec.p256(), shares.p256[0..], &pk[0..])
        put16(a, &out, 0x0017)
        put16(a, &out, 65)
        a.append_str(&out, pk[0..])
    }
    if (which & P384 != 0) {
        var pk: [97]u8 = @splat(0)
        try ec.public_key(ec.p384(), shares.p384[0..], &pk[0..])
        put16(a, &out, 0x0018)
        put16(a, &out, 97)
        a.append_str(&out, pk[0..])
    }
    const ext_len = @len(out) - ext_at - 2
    out[ext_at] = @as(u8, ext_len >> 8)
    out[ext_at + 1] = @as(u8, ext_len & 0xFF)
    const n = @len(out) - 4
    out[1] = @as(u8, n >> 16)
    out[2] = @as(u8, (n >> 8) & 0xFF)
    out[3] = @as(u8, n & 0xFF)
}

// Is this ServerHello body a HelloRetryRequest? Its random is SHA-256 of
// "HelloRetryRequest".
fn is_retry(body: []u8) bool {
    const magic = [32]u8{
        0xCF, 0x21, 0xAD, 0x74, 0xE5, 0x9A, 0x61, 0x11, 0xBE, 0x1D, 0x8C, 0x02, 0x1E, 0x65, 0xB8, 0x91,
        0xC2, 0xA2, 0x11, 0x16, 0x7A, 0xBB, 0x8C, 0x5E, 0x07, 0x9E, 0x09, 0xE2, 0xC8, 0xA8, 0x33, 0x9C,
    }
    return body[2..34] == magic[0..]
}

// The groups whose shares a ClientHello message carries, as bits; 0 if it
// does not parse.
fn shares_in(hello: []u8) i64 {
    // Header, version, random; session id; suites; compression.
    var at = 4 + 2 + 32
    if (@len(hello) < at + 1) {
        return 0
    }
    at = at + 1 + @as(i64, hello[at])
    if (@len(hello) < at + 2) {
        return 0
    }
    at = at + 2 + be16(hello, at)
    if (@len(hello) < at + 1) {
        return 0
    }
    at = at + 1 + @as(i64, hello[at])
    if (@len(hello) < at + 2) {
        return 0
    }
    at = at + 2
    var bits = 0
    while (at + 4 <= @len(hello)) {
        const ext = be16(hello, at)
        const n = be16(hello, at + 2)
        if (ext == 51 and at + 6 <= @len(hello)) {
            var p = at + 6
            while (p + 4 <= at + 4 + n) {
                bits = bits | group_bit(be16(hello, p))
                p = p + 4 + be16(hello, p + 2)
            }
        }
        at = at + 4 + n
    }
    return bits
}

// An IP address, which server_name may not carry: digits and dots, or a
// colon (IPv6).
fn is_ip(host: []u8) bool {
    var digits_and_dots = true
    for (host) |c| {
        if (c == ':') {
            return true
        }
        if (c != '.' and (c < '0' or c > '9')) {
            digits_and_dots = false
        }
    }
    return digits_and_dots
}

// Checks that body[at..] is a u16-length list of extensions, each
// { u16 type; u16 length; data }, that fills it, with no type twice.
fn check_extensions(body: []u8, at: i64) !void {
    if (@len(body) < at + 2 or be16(body, at) != @len(body) - at - 2) {
        return error.DecodeError
    }
    var i = at + 2
    while (i < @len(body)) {
        if (@len(body) - i < 4 or be16(body, i + 2) > @len(body) - i - 4) {
            return error.DecodeError
        }
        var j = at + 2
        while (j < i) {
            if (be16(body, j) == be16(body, i)) {
                return error.IllegalParameter
            }
            j = j + 4 + be16(body, j + 2)
        }
        i = i + 4 + be16(body, i + 2)
    }
}

// A Certificate message's body: u8 context length (0 from a server),
// context; a u24-length list of { u24 length, cert; u16 length, extensions },
// not empty. The certificates themselves are checked in step 5.
fn check_certificate(body: []u8) !void {
    if (@len(body) < 4 or body[0] != 0 or be24(body, 1) != @len(body) - 4) {
        return error.DecodeError
    }
    if (@len(body) == 4) {
        return error.CertificateRequired
    }
    var at = 4
    while (at < @len(body)) {
        if (@len(body) - at < 3) {
            return error.DecodeError
        }
        const n = be24(body, at)
        if (n == 0 or @len(body) - at - 3 < n + 2) {
            return error.DecodeError
        }
        at = at + 3 + n
        const e = be16(body, at)
        if (@len(body) - at - 2 < e) {
            return error.DecodeError
        }
        at = at + 2 + e
    }
}

// The next application traffic secret (RFC 8446, 7.2), in place.
fn next_secret(h: ks.HashKind, inout secret: []u8) void {
    var old: [48]u8 = @splat(0)
    defer @secureZero(&old)
    const hl = ks.hash_len(h)
    var i = 0
    while (i < hl) {
        old[i] = secret[i]
        i = i + 1
    }
    ks.expand_label(h, old[0..hl], "traffic upd", "", &secret[0..hl])
}

// Equal, in time that depends only on the lengths.
fn same(x: []u8, y: []u8) bool {
    if (@len(x) != @len(y)) {
        return false
    }
    var d: u8 = 0
    var i = 0
    while (i < @len(x)) {
        d = d | (x[i] ^ y[i])
        i = i + 1
    }
    return d == 0
}

fn be16(b: []u8, at: i64) i64 {
    return @as(i64, b[at]) << 8 | @as(i64, b[at + 1])
}

fn be24(b: []u8, at: i64) i64 {
    return @as(i64, b[at]) << 16 | @as(i64, b[at + 1]) << 8 | @as(i64, b[at + 2])
}

fn put16(a: Allocator, inout b: Buf(u8), x: i64) void {
    a.push(&b, @as(u8, x >> 8))
    a.push(&b, @as(u8, x & 0xFF))
}

fn put24(a: Allocator, inout b: Buf(u8), x: i64) void {
    a.push(&b, @as(u8, x >> 16))
    a.push(&b, @as(u8, (x >> 8) & 0xFF))
    a.push(&b, @as(u8, x & 0xFF))
}

// Removes the first n bytes of b.
fn drop_front(a: Allocator, inout b: Buf(u8), n: i64) void {
    if (n == 0) {
        return
    }
    const rest = @len(b) - n
    var i = 0
    while (i < rest) {
        b[i] = b[n + i]
        i = i + 1
    }
    a.resize(&b, rest, 0)
}
