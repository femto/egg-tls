// ecdsa: verifying ECDSA signatures (FIPS 186-5, 6.4.2) on P-256 and
// P-384, as certificates and TLS's CertificateVerify carry them.
//
//     const c = ec.p256()
//     try ecdsa.verify_der(c, public_key, digest, signature)
//
// public_key is an uncompressed point; digest the message's hash (any
// length: the leftmost c.size bytes are used, as FIPS 186-5 says for a
// hash longer than the order); signature the DER of
// SEQUENCE { INTEGER r, INTEGER s }. A signature that does not verify,
// or does not parse, is error.BadSignature, and a key not on the curve
// error.BadPoint. Everything here is public, but the arithmetic is
// tls/ec's, which is constant time anyway.

const ec = @import("ec.egg")

// The signature (r, s), each at most c.size big-endian bytes.
fn verify(c: ec.Curve, public_key: []u8, digest: []u8, r: []u8, s: []u8) !void {
    const q = try ec.decode_point(c, public_key)
    if (@len(r) > c.size or @len(s) > c.size) {
        return error.BadSignature
    }
    const rv = ec.from_be(r)
    const sv = ec.from_be(s)
    // 1 <= r, s < n.
    if (ec.is_zero(c.q, rv) == 1 or ec.below(c.q, rv) == 0 or ec.is_zero(c.q, sv) == 1 or ec.below(c.q, sv) == 0) {
        return error.BadSignature
    }
    // e: the leftmost bits of the digest, as many as the order has (256
    // or 384, whole bytes), reduced mod n (it is below 2 n).
    const take = if (@len(digest) > c.size) c.size else @len(digest)
    const zero: ec.Fe = @splat(0)
    const e = ec.reduce_once(c.q, ec.from_be(digest[0..take]), 0)
    // w = 1 / s; u1 = e w, u2 = r w (mod n).
    const w = ec.inv(c.q, ec.to_mont(c.q, sv))
    const u1 = ec.from_mont(c.q, ec.mul(c.q, ec.to_mont(c.q, e), w))
    const u2 = ec.from_mont(c.q, ec.mul(c.q, ec.to_mont(c.q, rv), w))
    var k1: [48]u8 = @splat(0)
    var k2: [48]u8 = @splat(0)
    ec.to_be(u1, &k1[0..c.size])
    ec.to_be(u2, &k2[0..c.size])
    const p1 = ec.scalar_mul(c, k1[0..c.size], ec.generator(c))
    const p2 = ec.scalar_mul(c, k2[0..c.size], q)
    const a = ec.affine(c, ec.add_points(c, p1, p2))
    if (a.infinite == 1) {
        return error.BadSignature
    }
    // x mod n == r; x < p < 2 n.
    if (!ec.equal(c.q, ec.add(c.q, a.x, zero), rv)) {
        return error.BadSignature
    }
}

// The signature as DER: SEQUENCE { INTEGER r, INTEGER s }, with nothing
// after it.
fn verify_der(c: ec.Curve, public_key: []u8, digest: []u8, signature: []u8) !void {
    // 0x30, length (one byte, or 0x81 and one byte), then two INTEGERs.
    if (@len(signature) < 2 or signature[0] != 0x30) {
        return error.BadSignature
    }
    var at = 2
    var len = @as(i64, signature[1])
    if (len == 0x81) {
        if (@len(signature) < 3 or signature[2] < 0x80) {
            return error.BadSignature
        }
        len = @as(i64, signature[2])
        at = 3
    } else if (len > 0x7F) {
        return error.BadSignature
    }
    if (at + len != @len(signature)) {
        return error.BadSignature
    }
    const r_end = try integer_end(signature, at)
    const s_end = try integer_end(signature, r_end)
    if (s_end != @len(signature)) {
        return error.BadSignature
    }
    const r = integer(signature, at)
    const s = integer(signature, r_end)
    try verify(c, public_key, digest, signature[r.lo..r.hi], signature[s.lo..s.hi])
}

const Span = struct {
    lo: i64
    hi: i64
}

// Where the INTEGER starting at at ends; it must be positive and
// minimally encoded.
fn integer_end(b: []u8, at: i64) !i64 {
    if (@len(b) - at < 3 or b[at] != 2) {
        return error.BadSignature
    }
    const n = @as(i64, b[at + 1])
    if (n == 0 or n > 0x7F or @len(b) - at - 2 < n) {
        return error.BadSignature
    }
    // Negative, or a leading zero not needed for the sign.
    if (b[at + 2] >= 0x80 or (n > 1 and b[at + 2] == 0 and b[at + 3] < 0x80)) {
        return error.BadSignature
    }
    return at + 2 + n
}

// The INTEGER's value bytes at at, without a leading zero.
fn integer(b: []u8, at: i64) Span {
    const n = @as(i64, b[at + 1])
    var lo = at + 2
    if (n > 1 and b[lo] == 0) {
        lo = lo + 1
    }
    return Span{ .lo = lo, .hi = at + 2 + n }
}
