// ec: the NIST curves P-256 and P-384 (FIPS 186-5, SEC 1), for TLS key
// shares (ECDH) and, in tls/ecdsa, signatures.
//
//     const c = ec.p256()                  // or ec.p384()
//     var ours: [65]u8 = @splat(0)          // 1 + 2 * c.size bytes
//     try ec.public_key(c, secret[0..], &ours[0..])
//     var shared: [32]u8 = @splat(0)        // c.size bytes: the x of the point
//     try ec.shared(c, secret[0..], theirs[0..], &shared[0..])
//
// A secret is c.size bytes, big-endian, from 1 to the group order less
// one (error.BadScalar otherwise); a public key is SEC 1's uncompressed
// point, 0x04 then x and y, which must be on the curve (error.BadPoint).
//
// Numbers are 64-bit limbs, least significant first, six of them (as
// many as P-384 needs; P-256 uses four), in Montgomery form; @mulWide
// gives each 128-bit product (tls/limb). Carries and borrows come from bit
// operations, not comparisons, so nothing branches on a value. Points are
// projective, added by the complete formulas of Renes, Costello and
// Batina (2016, Algorithm 4, for a = -3), which hold for every pair of
// points, the point at infinity and doubling included, so nothing
// branches on a secret. A scalar multiplication doubles and adds for
// every bit and keeps the sum by a mask.

const limb = @import("limb.egg")

const Fe = [6]u64

// Arithmetic modulo an odd m below 2^(64 n), with numbers in Montgomery
// form: x stands for x R mod m, R = 2^(64 n).
const Mod = struct {
    m: Fe
    n: i64
    // -1 / m mod 2^64.
    m0inv: u64
    // R mod m (one, in Montgomery form) and R^2 mod m.
    one: Fe
    r2: Fe
}

fn modulus(m: Fe, n: i64) Mod {
    // 1 / m mod 2^64 by Newton's iteration: each step doubles the bits
    // that are right, from 1 (m is odd).
    const m0 = m[0]
    var m_inv: u64 = 1
    var i = 0
    while (i < 6) {
        m_inv = m_inv *% (2 -% m0 *% m_inv)
        i = i + 1
    }
    var md = Mod{ .m = m, .n = n, .m0inv = 0 -% m_inv, .one = @splat(0), .r2 = @splat(0) }
    // 2^(64 n) and 2^(128 n) mod m, by doubling 1 (m is public).
    var x: Fe = @splat(0)
    x[0] = 1
    i = 0
    while (i < 128 * n) {
        x = add(md, x, x)
        i = i + 1
        if (i == 64 * n) {
            md.one = x
        }
    }
    md.r2 = x
    return md
}

// (a + b) mod m, for a and b below m.
fn add(md: Mod, a: Fe, b: Fe) Fe {
    var s: Fe = @splat(0)
    var carry: u64 = 0
    var i = 0
    while (i < md.n) {
        const t = limb.addc(a[i], b[i], carry)
        s[i] = t[0]
        carry = t[1]
        i = i + 1
    }
    return reduce_once(md, s, carry)
}

// s + carry 2^(64 n) less m, if that is not negative; else s.
fn reduce_once(md: Mod, s: Fe, carry: u64) Fe {
    var d: Fe = @splat(0)
    var borrow: u64 = 0
    var i = 0
    while (i < md.n) {
        const t = limb.subb(s[i], md.m[i], borrow)
        d[i] = t[0]
        borrow = t[1]
        i = i + 1
    }
    // Keep d unless the subtraction went below zero with no carry to pay.
    const keep_s = borrow & (carry ^ 1)
    return pick(md, keep_s, s, d)
}

// (a - b) mod m, for a and b below m.
fn sub(md: Mod, a: Fe, b: Fe) Fe {
    var d: Fe = @splat(0)
    var borrow: u64 = 0
    var i = 0
    while (i < md.n) {
        const t = limb.subb(a[i], b[i], borrow)
        d[i] = t[0]
        borrow = t[1]
        i = i + 1
    }
    // Below zero: add m back.
    const mask = 0 -% borrow
    var carry: u64 = 0
    i = 0
    while (i < md.n) {
        const t = limb.addc(d[i], md.m[i] & mask, carry)
        d[i] = t[0]
        carry = t[1]
        i = i + 1
    }
    return d
}

// a b / R mod m (CIOS Montgomery multiplication), for a and b below m.
fn mul(md: Mod, a: Fe, b: Fe) Fe {
    var t: [8]u64 = @splat(0)
    const n = md.n
    var i = 0
    while (i < n) {
        var carry: u64 = 0
        var j = 0
        while (j < n) {
            const w = limb.mac(a[j], b[i], t[j], carry)
            t[j] = w[0]
            carry = w[1]
            j = j + 1
        }
        var s = limb.addc(t[n], carry, 0)
        t[n] = s[0]
        t[n + 1] = s[1]
        // Add a multiple of m that clears the lowest limb, and shift.
        const u = t[0] *% md.m0inv
        var w = limb.mac(u, md.m[0], t[0], 0)
        carry = w[1]
        j = 1
        while (j < n) {
            w = limb.mac(u, md.m[j], t[j], carry)
            t[j - 1] = w[0]
            carry = w[1]
            j = j + 1
        }
        s = limb.addc(t[n], carry, 0)
        t[n - 1] = s[0]
        t[n] = t[n + 1] + s[1]
        i = i + 1
    }
    var r: Fe = @splat(0)
    i = 0
    while (i < n) {
        r[i] = t[i]
        i = i + 1
    }
    return reduce_once(md, r, t[n])
}

fn to_mont(md: Mod, a: Fe) Fe {
    return mul(md, a, md.r2)
}

fn from_mont(md: Mod, a: Fe) Fe {
    var one: Fe = @splat(0)
    one[0] = 1
    return mul(md, a, one)
}

// 1 / a mod m (m prime) as a^(m - 2), in Montgomery form; 0 for 0. The
// exponent is public, so its bits may steer the loop.
fn inv(md: Mod, a: Fe) Fe {
    var e = md.m
    e[0] = e[0] - 2
    var r = md.one
    var i = 64 * md.n - 1
    while (i >= 0) {
        r = mul(md, r, r)
        if ((e[i / 64] >> @as(u64, i % 64)) & 1 == 1) {
            r = mul(md, r, a)
        }
        i = i - 1
    }
    return r
}

// a when bit is 1, b when it is 0.
fn pick(md: Mod, bit: u64, a: Fe, b: Fe) Fe {
    const mask = 0 -% bit
    var r: Fe = @splat(0)
    var i = 0
    while (i < md.n) {
        r[i] = (a[i] & mask) | (b[i] & ~mask)
        i = i + 1
    }
    return r
}

// 1 if a is zero, else 0.
fn is_zero(md: Mod, a: Fe) u64 {
    var d: u64 = 0
    var i = 0
    while (i < md.n) {
        d = d | a[i]
        i = i + 1
    }
    // The top bit of d | -d is set unless d is 0.
    return ((d | (0 -% d)) >> 63) ^ 1
}

// 1 if a < m, else 0.
fn below(md: Mod, a: Fe) u64 {
    var borrow: u64 = 0
    var i = 0
    while (i < md.n) {
        borrow = limb.subb(a[i], md.m[i], borrow)[1]
        i = i + 1
    }
    return borrow
}

fn equal(md: Mod, a: Fe, b: Fe) bool {
    var d: u64 = 0
    var i = 0
    while (i < md.n) {
        d = d | (a[i] ^ b[i])
        i = i + 1
    }
    return d == 0
}

// The big-endian bytes b (at most 8 n of them) as limbs.
fn from_be(b: []u8) Fe {
    var r: Fe = @splat(0)
    var i = 0
    const len = @len(b)
    while (i < len) {
        const k = len - 1 - i
        r[k / 8] = r[k / 8] | (@as(u64, b[i]) << @as(u64, 8 * (k % 8)))
        i = i + 1
    }
    return r
}

// a as big-endian bytes, filling out.
fn to_be(a: Fe, inout out: []u8) void {
    const len = @len(out)
    var i = 0
    while (i < len) {
        const k = len - 1 - i
        out[i] = @as(u8, (a[k / 8] >> @as(u64, 8 * (k % 8))) & 0xFF)
        i = i + 1
    }
}

const Curve = struct {
    // Bytes of a coordinate or a scalar: 32 or 48.
    size: i64
    p: Mod
    // The group's order.
    q: Mod
    // b, and the generator, in Montgomery form mod p.
    b: Fe
    gx: Fe
    gy: Fe
}

fn p256() Curve {
    const p = [6]u64{ 0xFFFFFFFFFFFFFFFF, 0x00000000FFFFFFFF, 0x0000000000000000, 0xFFFFFFFF00000001, 0x0000000000000000, 0x0000000000000000 }
    const b = [6]u64{ 0x3BCE3C3E27D2604B, 0x651D06B0CC53B0F6, 0xB3EBBD55769886BC, 0x5AC635D8AA3A93E7, 0x0000000000000000, 0x0000000000000000 }
    const n = [6]u64{ 0xF3B9CAC2FC632551, 0xBCE6FAADA7179E84, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFF00000000, 0x0000000000000000, 0x0000000000000000 }
    const gx = [6]u64{ 0xF4A13945D898C296, 0x77037D812DEB33A0, 0xF8BCE6E563A440F2, 0x6B17D1F2E12C4247, 0x0000000000000000, 0x0000000000000000 }
    const gy = [6]u64{ 0xCBB6406837BF51F5, 0x2BCE33576B315ECE, 0x8EE7EB4A7C0F9E16, 0x4FE342E2FE1A7F9B, 0x0000000000000000, 0x0000000000000000 }
    return curve(32, p, b, n, gx, gy)
}

fn p384() Curve {
    const p = [6]u64{ 0x00000000FFFFFFFF, 0xFFFFFFFF00000000, 0xFFFFFFFFFFFFFFFE, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF }
    const b = [6]u64{ 0x2A85C8EDD3EC2AEF, 0xC656398D8A2ED19D, 0x0314088F5013875A, 0x181D9C6EFE814112, 0x988E056BE3F82D19, 0xB3312FA7E23EE7E4 }
    const n = [6]u64{ 0xECEC196ACCC52973, 0x581A0DB248B0A77A, 0xC7634D81F4372DDF, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF }
    const gx = [6]u64{ 0x3A545E3872760AB7, 0x5502F25DBF55296C, 0x59F741E082542A38, 0x6E1D3B628BA79B98, 0x8EB1C71EF320AD74, 0xAA87CA22BE8B0537 }
    const gy = [6]u64{ 0x7A431D7C90EA0E5F, 0x0A60B1CE1D7E819D, 0xE9DA3113B5F0B8C0, 0xF8F41DBD289A147C, 0x5D9E98BF9292DC29, 0x3617DE4A96262C6F }
    return curve(48, p, b, n, gx, gy)
}

fn curve(size: i64, p: Fe, b: Fe, n: Fe, gx: Fe, gy: Fe) Curve {
    const fp = modulus(p, size / 8)
    return Curve{ .size = size, .p = fp, .q = modulus(n, size / 8), .b = to_mont(fp, b), .gx = to_mont(fp, gx), .gy = to_mont(fp, gy) }
}

// A point in projective coordinates (X : Y : Z), Montgomery form; Z = 0
// is the point at infinity.
const Point = struct {
    x: Fe
    y: Fe
    z: Fe
}

fn infinity(c: Curve) Point {
    return Point{ .x = @splat(0), .y = c.p.one, .z = @splat(0) }
}

fn generator(c: Curve) Point {
    return Point{ .x = c.gx, .y = c.gy, .z = c.p.one }
}

// P + Q, for any two points (Renes, Costello, Batina 2016, Algorithm 4).
fn add_points(c: Curve, p1: Point, p2: Point) Point {
    const f = c.p
    var t0 = mul(f, p1.x, p2.x)
    var t1 = mul(f, p1.y, p2.y)
    var t2 = mul(f, p1.z, p2.z)
    var t3 = add(f, p1.x, p1.y)
    var t4 = add(f, p2.x, p2.y)
    t3 = mul(f, t3, t4)
    t4 = add(f, t0, t1)
    t3 = sub(f, t3, t4)
    t4 = add(f, p1.y, p1.z)
    var x3 = add(f, p2.y, p2.z)
    t4 = mul(f, t4, x3)
    x3 = add(f, t1, t2)
    t4 = sub(f, t4, x3)
    x3 = add(f, p1.x, p1.z)
    var y3 = add(f, p2.x, p2.z)
    x3 = mul(f, x3, y3)
    y3 = add(f, t0, t2)
    y3 = sub(f, x3, y3)
    var z3 = mul(f, c.b, t2)
    x3 = sub(f, y3, z3)
    z3 = add(f, x3, x3)
    x3 = add(f, x3, z3)
    z3 = sub(f, t1, x3)
    x3 = add(f, t1, x3)
    y3 = mul(f, c.b, y3)
    t1 = add(f, t2, t2)
    t2 = add(f, t1, t2)
    y3 = sub(f, y3, t2)
    y3 = sub(f, y3, t0)
    t1 = add(f, y3, y3)
    y3 = add(f, t1, y3)
    t1 = add(f, t0, t0)
    t0 = add(f, t1, t0)
    t0 = sub(f, t0, t2)
    t1 = mul(f, t4, y3)
    t2 = mul(f, t0, y3)
    y3 = mul(f, x3, z3)
    y3 = add(f, y3, t2)
    x3 = mul(f, t3, x3)
    x3 = sub(f, x3, t1)
    z3 = mul(f, t4, z3)
    t1 = mul(f, t3, t0)
    z3 = add(f, z3, t1)
    return Point{ .x = x3, .y = y3, .z = z3 }
}

// k P, for k given as c.size big-endian bytes. Every bit costs a
// doubling and an addition, and the sum is kept or not by a mask.
fn scalar_mul(c: Curve, k: []u8, p: Point) Point {
    var r = infinity(c)
    defer @secureZero(&r)
    for (k) |byte| {
        var j: u32 = 8
        while (j > 0) {
            j = j - 1
            r = add_points(c, r, r)
            var t = add_points(c, r, p)
            defer @secureZero(&t)
            const bit = @as(u64, (byte >> j) & 1)
            r = Point{ .x = pick(c.p, bit, t.x, r.x), .y = pick(c.p, bit, t.y, r.y), .z = pick(c.p, bit, t.z, r.z) }
        }
    }
    return r
}

// The affine x and y of p, plain (not Montgomery), and 1 if p is the point
// at infinity.
const Affine = struct {
    x: Fe
    y: Fe
    infinite: u64
}

fn affine(c: Curve, p: Point) Affine {
    var zi = inv(c.p, p.z)
    defer @secureZero(&zi)
    return Affine{ .x = from_mont(c.p, mul(c.p, p.x, zi)), .y = from_mont(c.p, mul(c.p, p.y, zi)), .infinite = is_zero(c.p, p.z) }
}

// An uncompressed point, 0x04, x, y, on the curve, or error.BadPoint.
fn decode_point(c: Curve, b: []u8) !Point {
    if (@len(b) != 1 + 2 * c.size or b[0] != 4) {
        return error.BadPoint
    }
    const x = from_be(b[1..1 + c.size])
    const y = from_be(b[1 + c.size..])
    if (below(c.p, x) == 0 or below(c.p, y) == 0) {
        return error.BadPoint
    }
    const xm = to_mont(c.p, x)
    const ym = to_mont(c.p, y)
    // y^2 = x^3 - 3 x + b.
    const x3 = mul(c.p, mul(c.p, xm, xm), xm)
    const three_x = add(c.p, add(c.p, xm, xm), xm)
    const rhs = add(c.p, sub(c.p, x3, three_x), c.b)
    if (!equal(c.p, mul(c.p, ym, ym), rhs)) {
        return error.BadPoint
    }
    return Point{ .x = xm, .y = ym, .z = c.p.one }
}

// Checks a secret scalar: c.size bytes, from 1 to the order less one.
fn check_scalar(c: Curve, k: []u8) !void {
    if (@len(k) != c.size) {
        return error.BadScalar
    }
    var v = from_be(k)
    defer @secureZero(&v)
    if (is_zero(c.q, v) == 1 or below(c.q, v) == 0) {
        return error.BadScalar
    }
}

// The public key of secret, as an uncompressed point (1 + 2 c.size bytes)
// in out.
fn public_key(c: Curve, secret: []u8, inout out: []u8) !void {
    try check_scalar(c, secret)
    var p = scalar_mul(c, secret, generator(c))
    defer @secureZero(&p)
    const a = affine(c, p)
    out[0] = 4
    to_be(a.x, &out[1..1 + c.size])
    to_be(a.y, &out[1 + c.size..1 + 2 * c.size])
}

// The ECDH shared secret of secret and the peer's public key: the x of
// their product, c.size bytes, in out. error.BadPoint for a key not on
// the curve; error.WeakKey for a product at infinity (impossible for a
// valid key on these prime-order curves, but checked).
fn shared(c: Curve, secret: []u8, peer: []u8, inout out: []u8) !void {
    try check_scalar(c, secret)
    const q = try decode_point(c, peer)
    var p = scalar_mul(c, secret, q)
    defer @secureZero(&p)
    var a = affine(c, p)
    defer @secureZero(&a)
    if (a.infinite == 1) {
        return error.WeakKey
    }
    to_be(a.x, &out[0..c.size])
}
