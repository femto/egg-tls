// ec: the NIST curves P-256 and P-384 (FIPS 186-5, SEC 1), for TLS key
// shares (ECDH) and, in tls/ecdsa, signatures.
//
//     const c = ec.p256()                  // or ec.p384()
//     var ours: [65]u8 = @splat(0)          // 1 + 2 * c.size bytes
//     try ec.public_key(c, secret[0..], &ours[0..])
//     var shared: [32]u8 = @splat(0)        // c.size bytes: the x of the point
//     try ec.shared(c, secret[0..], theirs[0..], &shared[0..])
//
// A secret is c.size bytes, big-endian, from 1 to the group order less
// one (error.BadScalar otherwise); a public key is SEC 1's uncompressed
// point, 0x04 then x and y, which must be on the curve (error.BadPoint).
//
// Numbers are 32-bit limbs, least significant first, twelve of them (as
// many as P-384 needs; P-256 uses eight), in Montgomery form. Egg has no
// 128-bit product yet, so limbs are 32 bits and products 64. Points are
// projective, added by the complete formulas of Renes, Costello and
// Batina (2016, Algorithm 4, for a = -3), which hold for every pair of
// points, the point at infinity and doubling included, so nothing
// branches on a secret. A scalar multiplication doubles and adds for
// every bit and keeps the sum by a mask.

const M32: u64 = 0xFFFF_FFFF

const Fe = [12]u32

// Arithmetic modulo an odd m below 2^(32 n), with numbers in Montgomery
// form: x stands for x R mod m, R = 2^(32 n).
const Mod = struct {
    m: Fe
    n: i64
    // -1 / m mod 2^32.
    m0inv: u64
    // R mod m (one, in Montgomery form) and R^2 mod m.
    one: Fe
    r2: Fe
}

fn modulus(m: Fe, n: i64) Mod {
    // 1 / m mod 2^32 by Newton's iteration: each step doubles the bits
    // that are right, from 1 (m is odd).
    const m0 = @as(u64, m[0])
    var m_inv: u64 = 1
    var i = 0
    while (i < 5) {
        m_inv = (m_inv *% (2 -% m0 *% m_inv)) & M32
        i = i + 1
    }
    var md = Mod{ .m = m, .n = n, .m0inv = (0 -% m_inv) & M32, .one = @splat(0), .r2 = @splat(0) }
    // 2^(32 n) and 2^(64 n) mod m, by doubling 1 (m is public).
    var x: Fe = @splat(0)
    x[0] = 1
    i = 0
    while (i < 64 * n) {
        x = add(md, x, x)
        i = i + 1
        if (i == 32 * n) {
            md.one = x
        }
    }
    md.r2 = x
    return md
}

// (a + b) mod m, for a and b below m.
fn add(md: Mod, a: Fe, b: Fe) Fe {
    var s: Fe = @splat(0)
    var carry: u64 = 0
    var i = 0
    while (i < md.n) {
        const t = @as(u64, a[i]) + @as(u64, b[i]) + carry
        s[i] = @as(u32, t & M32)
        carry = t >> 32
        i = i + 1
    }
    return reduce_once(md, s, carry)
}

// s + carry 2^(32 n) less m, if that is not negative; else s.
fn reduce_once(md: Mod, s: Fe, carry: u64) Fe {
    var d: Fe = @splat(0)
    var borrow: u64 = 0
    var i = 0
    while (i < md.n) {
        const t = @as(u64, s[i]) -% @as(u64, md.m[i]) -% borrow
        d[i] = @as(u32, t & M32)
        borrow = (t >> 32) & 1
        i = i + 1
    }
    // Keep d unless the subtraction went below zero with no carry to pay.
    const keep_s = borrow & (carry ^ 1)
    return pick(md, keep_s, s, d)
}

// (a - b) mod m, for a and b below m.
fn sub(md: Mod, a: Fe, b: Fe) Fe {
    var d: Fe = @splat(0)
    var borrow: u64 = 0
    var i = 0
    while (i < md.n) {
        const t = @as(u64, a[i]) -% @as(u64, b[i]) -% borrow
        d[i] = @as(u32, t & M32)
        borrow = (t >> 32) & 1
        i = i + 1
    }
    // Below zero: add m back.
    const mask = 0 -% borrow
    var carry: u64 = 0
    i = 0
    while (i < md.n) {
        const t = @as(u64, d[i]) + (@as(u64, md.m[i]) & mask) + carry
        d[i] = @as(u32, t & M32)
        carry = t >> 32
        i = i + 1
    }
    return d
}

// a b / R mod m (CIOS Montgomery multiplication), for a and b below m.
fn mul(md: Mod, a: Fe, b: Fe) Fe {
    var t: [14]u64 = @splat(0)
    const n = md.n
    var i = 0
    while (i < n) {
        const bi = @as(u64, b[i])
        var carry: u64 = 0
        var j = 0
        while (j < n) {
            const s = t[j] + @as(u64, a[j]) * bi + carry
            t[j] = s & M32
            carry = s >> 32
            j = j + 1
        }
        var s = t[n] + carry
        t[n] = s & M32
        t[n + 1] = s >> 32
        // Add a multiple of m that clears the lowest limb, and shift.
        const u = (t[0] * md.m0inv) & M32
        s = t[0] + u * @as(u64, md.m[0])
        carry = s >> 32
        j = 1
        while (j < n) {
            s = t[j] + u * @as(u64, md.m[j]) + carry
            t[j - 1] = s & M32
            carry = s >> 32
            j = j + 1
        }
        s = t[n] + carry
        t[n - 1] = s & M32
        t[n] = t[n + 1] + (s >> 32)
        i = i + 1
    }
    var r: Fe = @splat(0)
    i = 0
    while (i < n) {
        r[i] = @as(u32, t[i])
        i = i + 1
    }
    return reduce_once(md, r, t[n])
}

fn to_mont(md: Mod, a: Fe) Fe {
    return mul(md, a, md.r2)
}

fn from_mont(md: Mod, a: Fe) Fe {
    var one: Fe = @splat(0)
    one[0] = 1
    return mul(md, a, one)
}

// 1 / a mod m (m prime) as a^(m - 2), in Montgomery form; 0 for 0. The
// exponent is public, so its bits may steer the loop.
fn inv(md: Mod, a: Fe) Fe {
    var e = md.m
    e[0] = e[0] - 2
    var r = md.one
    var i = 32 * md.n - 1
    while (i >= 0) {
        r = mul(md, r, r)
        if ((e[i / 32] >> @as(u32, i % 32)) & 1 == 1) {
            r = mul(md, r, a)
        }
        i = i - 1
    }
    return r
}

// a when mask is 1, b when it is 0.
fn pick(md: Mod, bit: u64, a: Fe, b: Fe) Fe {
    const mask = @as(u32, (0 -% bit) & M32)
    var r: Fe = @splat(0)
    var i = 0
    while (i < md.n) {
        r[i] = (a[i] & mask) | (b[i] & ~mask)
        i = i + 1
    }
    return r
}

// 1 if a is zero, else 0.
fn is_zero(md: Mod, a: Fe) u64 {
    var d: u32 = 0
    var i = 0
    while (i < md.n) {
        d = d | a[i]
        i = i + 1
    }
    return ((@as(u64, d) -% 1) >> 63) & 1
}

// 1 if a < m, else 0.
fn below(md: Mod, a: Fe) u64 {
    var borrow: u64 = 0
    var i = 0
    while (i < md.n) {
        const t = @as(u64, a[i]) -% @as(u64, md.m[i]) -% borrow
        borrow = (t >> 32) & 1
        i = i + 1
    }
    return borrow
}

fn equal(md: Mod, a: Fe, b: Fe) bool {
    var d: u32 = 0
    var i = 0
    while (i < md.n) {
        d = d | (a[i] ^ b[i])
        i = i + 1
    }
    return d == 0
}

// The big-endian bytes b (at most 4 n of them) as limbs.
fn from_be(b: []u8) Fe {
    var r: Fe = @splat(0)
    var i = 0
    const len = @len(b)
    while (i < len) {
        const k = len - 1 - i
        r[k / 4] = r[k / 4] | (@as(u32, b[i]) << @as(u32, 8 * (k % 4)))
        i = i + 1
    }
    return r
}

// a as big-endian bytes, filling out.
fn to_be(a: Fe, inout out: []u8) void {
    const len = @len(out)
    var i = 0
    while (i < len) {
        const k = len - 1 - i
        out[i] = @as(u8, (a[k / 4] >> @as(u32, 8 * (k % 4))) & 0xFF)
        i = i + 1
    }
}

const Curve = struct {
    // Bytes of a coordinate or a scalar: 32 or 48.
    size: i64
    p: Mod
    // The group's order.
    q: Mod
    // b, and the generator, in Montgomery form mod p.
    b: Fe
    gx: Fe
    gy: Fe
}

fn p256() Curve {
    const p = [12]u32{ 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x00000000, 0x00000000, 0x00000000, 0x00000001, 0xFFFFFFFF, 0, 0, 0, 0 }
    const b = [12]u32{ 0x27D2604B, 0x3BCE3C3E, 0xCC53B0F6, 0x651D06B0, 0x769886BC, 0xB3EBBD55, 0xAA3A93E7, 0x5AC635D8, 0, 0, 0, 0 }
    const n = [12]u32{ 0xFC632551, 0xF3B9CAC2, 0xA7179E84, 0xBCE6FAAD, 0xFFFFFFFF, 0xFFFFFFFF, 0x00000000, 0xFFFFFFFF, 0, 0, 0, 0 }
    const gx = [12]u32{ 0xD898C296, 0xF4A13945, 0x2DEB33A0, 0x77037D81, 0x63A440F2, 0xF8BCE6E5, 0xE12C4247, 0x6B17D1F2, 0, 0, 0, 0 }
    const gy = [12]u32{ 0x37BF51F5, 0xCBB64068, 0x6B315ECE, 0x2BCE3357, 0x7C0F9E16, 0x8EE7EB4A, 0xFE1A7F9B, 0x4FE342E2, 0, 0, 0, 0 }
    return curve(32, p, b, n, gx, gy)
}

fn p384() Curve {
    const p = [12]u32{ 0xFFFFFFFF, 0x00000000, 0x00000000, 0xFFFFFFFF, 0xFFFFFFFE, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF }
    const b = [12]u32{ 0xD3EC2AEF, 0x2A85C8ED, 0x8A2ED19D, 0xC656398D, 0x5013875A, 0x0314088F, 0xFE814112, 0x181D9C6E, 0xE3F82D19, 0x988E056B, 0xE23EE7E4, 0xB3312FA7 }
    const n = [12]u32{ 0xCCC52973, 0xECEC196A, 0x48B0A77A, 0x581A0DB2, 0xF4372DDF, 0xC7634D81, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF }
    const gx = [12]u32{ 0x72760AB7, 0x3A545E38, 0xBF55296C, 0x5502F25D, 0x82542A38, 0x59F741E0, 0x8BA79B98, 0x6E1D3B62, 0xF320AD74, 0x8EB1C71E, 0xBE8B0537, 0xAA87CA22 }
    const gy = [12]u32{ 0x90EA0E5F, 0x7A431D7C, 0x1D7E819D, 0x0A60B1CE, 0xB5F0B8C0, 0xE9DA3113, 0x289A147C, 0xF8F41DBD, 0x9292DC29, 0x5D9E98BF, 0x96262C6F, 0x3617DE4A }
    return curve(48, p, b, n, gx, gy)
}

fn curve(size: i64, p: Fe, b: Fe, n: Fe, gx: Fe, gy: Fe) Curve {
    const fp = modulus(p, size / 4)
    return Curve{ .size = size, .p = fp, .q = modulus(n, size / 4), .b = to_mont(fp, b), .gx = to_mont(fp, gx), .gy = to_mont(fp, gy) }
}

// A point in projective coordinates (X : Y : Z), Montgomery form; Z = 0
// is the point at infinity.
const Point = struct {
    x: Fe
    y: Fe
    z: Fe
}

fn infinity(c: Curve) Point {
    return Point{ .x = @splat(0), .y = c.p.one, .z = @splat(0) }
}

fn generator(c: Curve) Point {
    return Point{ .x = c.gx, .y = c.gy, .z = c.p.one }
}

// P + Q, for any two points (Renes, Costello, Batina 2016, Algorithm 4).
fn add_points(c: Curve, p1: Point, p2: Point) Point {
    const f = c.p
    var t0 = mul(f, p1.x, p2.x)
    var t1 = mul(f, p1.y, p2.y)
    var t2 = mul(f, p1.z, p2.z)
    var t3 = add(f, p1.x, p1.y)
    var t4 = add(f, p2.x, p2.y)
    t3 = mul(f, t3, t4)
    t4 = add(f, t0, t1)
    t3 = sub(f, t3, t4)
    t4 = add(f, p1.y, p1.z)
    var x3 = add(f, p2.y, p2.z)
    t4 = mul(f, t4, x3)
    x3 = add(f, t1, t2)
    t4 = sub(f, t4, x3)
    x3 = add(f, p1.x, p1.z)
    var y3 = add(f, p2.x, p2.z)
    x3 = mul(f, x3, y3)
    y3 = add(f, t0, t2)
    y3 = sub(f, x3, y3)
    var z3 = mul(f, c.b, t2)
    x3 = sub(f, y3, z3)
    z3 = add(f, x3, x3)
    x3 = add(f, x3, z3)
    z3 = sub(f, t1, x3)
    x3 = add(f, t1, x3)
    y3 = mul(f, c.b, y3)
    t1 = add(f, t2, t2)
    t2 = add(f, t1, t2)
    y3 = sub(f, y3, t2)
    y3 = sub(f, y3, t0)
    t1 = add(f, y3, y3)
    y3 = add(f, t1, y3)
    t1 = add(f, t0, t0)
    t0 = add(f, t1, t0)
    t0 = sub(f, t0, t2)
    t1 = mul(f, t4, y3)
    t2 = mul(f, t0, y3)
    y3 = mul(f, x3, z3)
    y3 = add(f, y3, t2)
    x3 = mul(f, t3, x3)
    x3 = sub(f, x3, t1)
    z3 = mul(f, t4, z3)
    t1 = mul(f, t3, t0)
    z3 = add(f, z3, t1)
    return Point{ .x = x3, .y = y3, .z = z3 }
}

// k P, for k given as c.size big-endian bytes. Every bit costs a
// doubling and an addition, and the sum is kept or not by a mask.
fn scalar_mul(c: Curve, k: []u8, p: Point) Point {
    var r = infinity(c)
    defer @secureZero(&r)
    for (k) |byte| {
        var j: u32 = 8
        while (j > 0) {
            j = j - 1
            r = add_points(c, r, r)
            var t = add_points(c, r, p)
            defer @secureZero(&t)
            const bit = @as(u64, (byte >> j) & 1)
            r = Point{ .x = pick(c.p, bit, t.x, r.x), .y = pick(c.p, bit, t.y, r.y), .z = pick(c.p, bit, t.z, r.z) }
        }
    }
    return r
}

// The affine x and y of p, plain (not Montgomery), and 1 if p is the point
// at infinity.
const Affine = struct {
    x: Fe
    y: Fe
    infinite: u64
}

fn affine(c: Curve, p: Point) Affine {
    var zi = inv(c.p, p.z)
    defer @secureZero(&zi)
    return Affine{ .x = from_mont(c.p, mul(c.p, p.x, zi)), .y = from_mont(c.p, mul(c.p, p.y, zi)), .infinite = is_zero(c.p, p.z) }
}

// An uncompressed point, 0x04, x, y, on the curve, or error.BadPoint.
fn decode_point(c: Curve, b: []u8) !Point {
    if (@len(b) != 1 + 2 * c.size or b[0] != 4) {
        return error.BadPoint
    }
    const x = from_be(b[1..1 + c.size])
    const y = from_be(b[1 + c.size..])
    if (below(c.p, x) == 0 or below(c.p, y) == 0) {
        return error.BadPoint
    }
    const xm = to_mont(c.p, x)
    const ym = to_mont(c.p, y)
    // y^2 = x^3 - 3 x + b.
    const x3 = mul(c.p, mul(c.p, xm, xm), xm)
    const three_x = add(c.p, add(c.p, xm, xm), xm)
    const rhs = add(c.p, sub(c.p, x3, three_x), c.b)
    if (!equal(c.p, mul(c.p, ym, ym), rhs)) {
        return error.BadPoint
    }
    return Point{ .x = xm, .y = ym, .z = c.p.one }
}

// Checks a secret scalar: c.size bytes, from 1 to the order less one.
fn check_scalar(c: Curve, k: []u8) !void {
    if (@len(k) != c.size) {
        return error.BadScalar
    }
    var v = from_be(k)
    defer @secureZero(&v)
    if (is_zero(c.q, v) == 1 or below(c.q, v) == 0) {
        return error.BadScalar
    }
}

// The public key of secret, as an uncompressed point (1 + 2 c.size bytes)
// in out.
fn public_key(c: Curve, secret: []u8, inout out: []u8) !void {
    try check_scalar(c, secret)
    var p = scalar_mul(c, secret, generator(c))
    defer @secureZero(&p)
    const a = affine(c, p)
    out[0] = 4
    to_be(a.x, &out[1..1 + c.size])
    to_be(a.y, &out[1 + c.size..1 + 2 * c.size])
}

// The ECDH shared secret of secret and the peer's public key: the x of
// their product, c.size bytes, in out. error.BadPoint for a key not on
// the curve; error.WeakKey for a product at infinity (impossible for a
// valid key on these prime-order curves, but checked).
fn shared(c: Curve, secret: []u8, peer: []u8, inout out: []u8) !void {
    try check_scalar(c, secret)
    const q = try decode_point(c, peer)
    var p = scalar_mul(c, secret, q)
    defer @secureZero(&p)
    var a = affine(c, p)
    defer @secureZero(&a)
    if (a.infinite == 1) {
        return error.WeakKey
    }
    to_be(a.x, &out[0..c.size])
}
