// x25519: X25519 Diffie-Hellman (RFC 7748), TLS 1.3's usual key exchange.
//
//     const mine = x25519.public_key(secret)       // secret: 32 random bytes
//     // send mine, receive theirs
//     const shared = try x25519.shared(secret, theirs)
//
// As in TweetNaCl: a field element is sixteen 16-bit limbs in i64s, the
// ladder swaps by masks, and nothing branches on or indexes by the secret,
// so its time does not depend on it. shared refuses a result of all zeros
// (error.WeakKey), as RFC 8446 says a client must: the peer sent a point
// of small order.

// An element of GF(2^255 - 19).
const Gf = [16]i64

// u = 9, the base point.
fn public_key(secret: [32]u8) [32]u8 {
    var nine: [32]u8 = @splat(0)
    nine[0] = 9
    return scalarmult(secret, nine)
}

fn shared(secret: [32]u8, peer: [32]u8) ![32]u8 {
    const s = scalarmult(secret, peer)
    var any: u8 = 0
    for (s[0..]) |b| {
        any = any | b
    }
    if (any == 0) {
        return error.WeakKey
    }
    return s
}

// The X25519 function: the scalar k (clamped) times the point u.
fn scalarmult(k: [32]u8, u: [32]u8) [32]u8 {
    var z = k
    z[31] = (z[31] & 127) | 64
    z[0] = z[0] & 248
    const x = unpack(u)
    var a: Gf = @splat(0)
    var b = x
    var c: Gf = @splat(0)
    var d: Gf = @splat(0)
    a[0] = 1
    d[0] = 1
    var small: Gf = @splat(0)
    small[0] = 0xDB41
    small[1] = 1
    var i = 254
    while (i >= 0) {
        const r = @as(i64, (z[i >> 3] >> (i & 7)) & 1)
        swap_if(&a, &b, r)
        swap_if(&c, &d, r)
        var e = add(a, c)
        a = sub(a, c)
        c = add(b, d)
        b = sub(b, d)
        d = square(e)
        const f = square(a)
        a = mul(c, a)
        c = mul(b, e)
        e = add(a, c)
        a = sub(a, c)
        b = square(a)
        c = sub(d, f)
        a = mul(c, small)
        a = add(a, d)
        c = mul(c, a)
        a = mul(d, f)
        d = mul(b, x)
        b = square(e)
        swap_if(&a, &b, r)
        swap_if(&c, &d, r)
        i = i - 1
    }
    return pack(mul(a, invert(c)))
}

// The 32 little-endian bytes as an element; the top bit is ignored.
fn unpack(n: [32]u8) Gf {
    var o: Gf = @splat(0)
    var i = 0
    while (i < 16) {
        o[i] = @as(i64, n[2 * i]) + (@as(i64, n[2 * i + 1]) << 8)
        i = i + 1
    }
    o[15] = o[15] & 0x7FFF
    return o
}

// The element reduced mod 2^255 - 19, as 32 little-endian bytes.
fn pack(n: Gf) [32]u8 {
    var t = carry(carry(carry(n)))
    var j = 0
    while (j < 2) {
        // m = t - p; keep t if that borrowed (t < p), else m.
        var m: Gf = @splat(0)
        m[0] = t[0] - 0xFFED
        var i = 1
        while (i < 15) {
            m[i] = t[i] - 0xFFFF - ((m[i - 1] >> 16) & 1)
            m[i - 1] = m[i - 1] & 0xFFFF
            i = i + 1
        }
        m[15] = t[15] - 0x7FFF - ((m[14] >> 16) & 1)
        const borrow = (m[15] >> 16) & 1
        m[14] = m[14] & 0xFFFF
        swap_if(&t, &m, 1 - borrow)
        j = j + 1
    }
    var o: [32]u8 = @splat(0)
    var i = 0
    while (i < 16) {
        o[2 * i] = @as(u8, t[i] & 0xFF)
        o[2 * i + 1] = @as(u8, (t[i] >> 8) & 0xFF)
        i = i + 1
    }
    return o
}

// Brings every limb back to 16 bits, carrying 2^256 = 38 round to limb 0.
fn carry(n: Gf) Gf {
    var o = n
    var i = 0
    while (i < 16) {
        o[i] = o[i] + 65536
        const c = o[i] >> 16
        if (i < 15) {
            o[i + 1] = o[i + 1] + c - 1
        } else {
            o[0] = o[0] + 38 * (c - 1)
        }
        o[i] = o[i] - (c << 16)
        i = i + 1
    }
    return o
}

// Swaps p and q when b is 1, leaves them when 0, by a mask.
fn swap_if(inout p: Gf, inout q: Gf, b: i64) void {
    const mask = ~(b - 1)
    var i = 0
    while (i < 16) {
        const t = mask & (p[i] ^ q[i])
        p[i] = p[i] ^ t
        q[i] = q[i] ^ t
        i = i + 1
    }
}

fn add(a: Gf, b: Gf) Gf {
    var o: Gf = @splat(0)
    var i = 0
    while (i < 16) {
        o[i] = a[i] + b[i]
        i = i + 1
    }
    return o
}

fn sub(a: Gf, b: Gf) Gf {
    var o: Gf = @splat(0)
    var i = 0
    while (i < 16) {
        o[i] = a[i] - b[i]
        i = i + 1
    }
    return o
}

fn mul(a: Gf, b: Gf) Gf {
    var t: [31]i64 = @splat(0)
    var i = 0
    while (i < 16) {
        var j = 0
        while (j < 16) {
            t[i + j] = t[i + j] + a[i] * b[j]
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while (i < 15) {
        t[i] = t[i] + 38 * t[i + 16]
        i = i + 1
    }
    var o: Gf = @splat(0)
    i = 0
    while (i < 16) {
        o[i] = t[i]
        i = i + 1
    }
    return carry(carry(o))
}

fn square(a: Gf) Gf {
    return mul(a, a)
}

// a^(p - 2) = 1 / a: the exponent's bits are fixed, not secret.
fn invert(a: Gf) Gf {
    var c = a
    var i = 253
    while (i >= 0) {
        c = square(c)
        if (i != 2 and i != 4) {
            c = mul(c, a)
        }
        i = i - 1
    }
    return c
}
