// hkdf: HKDF (RFC 5869), the key derivation TLS 1.3's key schedule is
// built on, over any of the hashes here.
//
//     var prk: [32]u8 = @splat(0)
//     Hkdf(Sha256).extract(salt, ikm, &prk[0..])
//     var okm: [42]u8 = @splat(0)
//     try Hkdf(Sha256).expand(prk[0..], info, &okm[0..])
//
// extract writes H.digest_len() bytes; expand fills out, which may hold up
// to 255 digests (more is error.TooLong). An empty salt means a digest of
// zeros, as RFC 5869 says: HMAC pads an empty key with zeros anyway.

const hmac = @import("hmac.egg")

fn Hkdf(comptime H: type) type {
    return struct {
        fn extract(salt: []u8, ikm: []u8, inout prk: []u8) void {
            var m = hmac.Hmac(H).init(salt)
            defer @secureZero(&m)
            m.update(ikm)
            m.final(&prk[0..])
        }

        fn expand(prk: []u8, info: []u8, inout out: []u8) !void {
            const hl = H.digest_len()
            if (@len(out) > 255 * hl) {
                return error.TooLong
            }
            // T(n) = HMAC(prk, T(n - 1) | info | n), T(0) empty.
            var keyed = hmac.Hmac(H).init(prk)
            defer @secureZero(&keyed)
            var t: [64]u8 = @splat(0)
            defer @secureZero(&t)
            var tlen = 0
            var n: u8 = 1
            var at = 0
            while (at < @len(out)) {
                var m = keyed
                defer @secureZero(&m)
                m.update(t[0..tlen])
                m.update(info)
                const counter = [1]u8{ n }
                m.update(counter[0..])
                m.final(&t[0..hl])
                tlen = hl
                var i = 0
                while (i < hl and at < @len(out)) {
                    out[at] = t[i]
                    at = at + 1
                    i = i + 1
                }
                n = n +% 1
            }
        }
    }
}
